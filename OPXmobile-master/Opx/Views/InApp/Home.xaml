<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Opx.Views.Home"
             xmlns:Renderers="clr-namespace:Opx.Renderers"
             BackgroundColor="#F4F5FB"
             NavigationPage.HasNavigationBar="False"
             Padding="0">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Renderers:StatusToGradientStartConverter x:Key="StatusToGradientStartConverter"/>
            <Renderers:StatusToColorConverter x:Key="StatusToColorConverter"/>

            <!-- Responsive tokens: defaults here, adjusted for the real screen size in Home.xaml.cs (OnSizeAllocated) -->
            <x:Double x:Key="HeroFont">30</x:Double>
            <x:Double x:Key="AcctFont">22</x:Double>
            <x:Double x:Key="ValueFont">14</x:Double>
            <x:Double x:Key="TileBox">44</x:Double>
            <x:Double x:Key="TileImg">22</x:Double>
            <x:Double x:Key="BlockGap">18</x:Double>
            <x:Double x:Key="CardGap">16</x:Double>
            <x:Double x:Key="BannerImg">64</x:Double>
            <Thickness x:Key="CardPad">22,20,22,22</Thickness>
            <Thickness x:Key="HeaderPad">20,28,20,26</Thickness>
            <Thickness x:Key="TilePad">0,14</Thickness>

            <Color x:Key="Ink">#161A2E</Color>
            <Color x:Key="Muted">#7A8099</Color>
            <Color x:Key="Brand">#6B4CE6</Color>

            <!-- Kept for other views that may still reference it -->
            <Style x:Key="CardStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="CornerRadius" Value="18"/>
                <Setter Property="HasShadow" Value="False"/>
                <Setter Property="BorderColor" Value="#ECEEF6"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="Label">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource Ink}"/>
            </Style>

            <Style x:Key="ActionTileStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="BorderColor" Value="#ECEEF6"/>
                <Setter Property="CornerRadius" Value="18"/>
                <Setter Property="HasShadow" Value="False"/>
                <Setter Property="Padding" Value="{DynamicResource TilePad}"/>
                <Setter Property="Margin" Value="0"/>
            </Style>

            <Style x:Key="ActionLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource Ink}"/>
                <Setter Property="HorizontalTextAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="#F4F5FB">
        <RefreshView x:Name="PullRefresh" RefreshColor="#6B4CE6" Refreshing="OnPullRefresh">
            <ScrollView VerticalScrollBarVisibility="Never">
                <Grid x:Name="PageGrid" RowDefinitions="Auto,*" RowSpacing="0" VerticalOptions="Fill">

                    <!-- ═════════ Header ═════════ -->
                    <Border x:Name="HeaderGrid" Grid.Row="0"
                        StrokeThickness="0"             BackgroundColor="#8E44AD"
                        Padding="{DynamicResource HeaderPad}"
                        StrokeShape="RoundRectangle 0,0,22,22">

                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                            <Frame Grid.Column="0" CornerRadius="22" HeightRequest="44" WidthRequest="44"
                               Padding="8" BackgroundColor="WhiteSmoke" BorderColor="Transparent"
                               HasShadow="False" x:Name="ProfileFrame">
                                <Image Source="logo.png" Aspect="AspectFit"/>
                            </Frame>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                <Label Text="Welcome back" FontSize="12" TextColor="#CCFFFFFF"/>
                                <Label x:Name="dashbaordusername" FontSize="18" FontAttributes="Bold"
                                   TextColor="White" LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>

                            <Frame Grid.Column="2" CornerRadius="22" HeightRequest="44" WidthRequest="44"
                               Padding="0" BackgroundColor="#33FFFFFF" BorderColor="Transparent"
                               HasShadow="False" x:Name="RefreshButton">
                                <Label Text="&#x21BB;" FontSize="22" FontAttributes="Bold" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRefreshTapped"/>
                                </Frame.GestureRecognizers>
                            </Frame>

                            <Frame Grid.Column="3" CornerRadius="22" HeightRequest="44" WidthRequest="44"
                               Padding="0" BackgroundColor="#33FFFFFF" BorderColor="Transparent"
                               HasShadow="False" x:Name="LogoutButton">
                                <Image Source="image8.png" HeightRequest="22" WidthRequest="22" Aspect="AspectFit"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLogoutClicked"/>
                                </Frame.GestureRecognizers>
                            </Frame>
                        </Grid>
                    </Border>

                    <Grid x:Name="MainContent" Grid.Row="1" Margin="0,-36,0,0" Padding="16,0,16,28"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="{DynamicResource BlockGap}"
                          HorizontalOptions="Fill" VerticalOptions="Start">

                        <!-- ═════════ Virtual account card (overlaps header) · centered, fills the content width ═════════ -->
                        <Border x:Name="EscrowCard" Grid.Row="0" Margin="0"
                            HorizontalOptions="Fill" VerticalOptions="Fill"
                            Stroke="#33FFFFFF" StrokeThickness="1" Padding="0"
                            StrokeShape="RoundRectangle 24">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1A0F40" Offset="0.0"/>
                                    <GradientStop Color="#3D2493" Offset="0.55"/>
                                    <GradientStop Color="#6B4CE6" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Shadow>
                                <Shadow Brush="#2B1B7A" Opacity="0.28" Radius="20" Offset="0,10"/>
                            </Border.Shadow>

                            <Grid HorizontalOptions="Fill">
                                <!-- Decorative translucent circles (clipped by the card corners) -->
                                <Border InputTransparent="True" StrokeThickness="0" BackgroundColor="#14FFFFFF"
                                    WidthRequest="170" HeightRequest="170" StrokeShape="RoundRectangle 85"
                                    HorizontalOptions="End" VerticalOptions="Start" Margin="0,-70,-60,0"/>
                                <Border InputTransparent="True" StrokeThickness="0" BackgroundColor="#0DFFFFFF"
                                    WidthRequest="130" HeightRequest="130" StrokeShape="RoundRectangle 65"
                                    HorizontalOptions="Start" VerticalOptions="End" Margin="-50,0,0,-60"/>

                                <Grid Padding="22,20,22,22" HorizontalOptions="Fill"
                                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

                                    <!-- Row 0: brand + badge -->
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <Border StrokeThickness="0" BackgroundColor="White" Padding="5"
                                            WidthRequest="28" HeightRequest="28" StrokeShape="RoundRectangle 14"
                                            VerticalOptions="Center">
                                            <Image Source="logo.png" Aspect="AspectFit"/>
                                        </Border>
                                        <Label Grid.Column="1" Text="OPX Wallet" FontSize="13" FontAttributes="Bold"
                                           TextColor="White" VerticalOptions="Center" MaxLines="1"/>
                                        <Border Grid.Column="2" Stroke="#80FFFFFF" StrokeThickness="1"
                                            BackgroundColor="#1AFFFFFF" Padding="10,4"
                                            StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                                            <Label Text="VIRTUAL ACCOUNT" FontSize="9" FontAttributes="Bold"
                                               CharacterSpacing="1" TextColor="White"/>
                                        </Border>
                                    </Grid>

                                    <!-- Row 1: balance (centered) + ledger pill -->
                                    <VerticalStackLayout Grid.Row="1" Margin="0,18,0,0" Spacing="4"
                                                         HorizontalOptions="Fill">
                                        <Label Text="AVAILABLE BALANCE" FontSize="10" FontAttributes="Bold"
                                           CharacterSpacing="1.5" TextColor="#B9B2E3" HorizontalTextAlignment="Center"/>
                                        <Label x:Name="BalanceLabel" FontSize="{DynamicResource HeroFont}" FontAttributes="Bold"
                                           LineBreakMode="TailTruncation" MaxLines="1" TextColor="White"
                                           HorizontalTextAlignment="Center"/>
                                        <Border StrokeThickness="0" BackgroundColor="#1FA971" Padding="12,4"
                                            StrokeShape="RoundRectangle 12" HorizontalOptions="Center" Margin="0,4,0,0">
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="Ledger" FontSize="10" TextColor="#E6FFFFFF" VerticalOptions="Center"/>
                                                <Label x:Name="AmountLabel" FontSize="11" FontAttributes="Bold"
                                                   LineBreakMode="TailTruncation" MaxLines="1" TextColor="White"
                                                   VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </Border>
                                    </VerticalStackLayout>

                                    <!-- Row 2: account number, centered in a frosted panel (tap to copy) -->
                                    <Border Grid.Row="2" Margin="0,18,0,0" HorizontalOptions="Fill"
                                        BackgroundColor="#1AFFFFFF" Stroke="#33FFFFFF" StrokeThickness="1"
                                        Padding="14,12" StrokeShape="RoundRectangle 16">
                                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                            <Label x:Name="cardaccountNumber" FontSize="{DynamicResource AcctFont}" FontAttributes="Bold"
                                               CharacterSpacing="2" LineBreakMode="NoWrap" MaxLines="1"
                                               TextColor="White" VerticalOptions="Center">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_5"/>
                                                </Label.GestureRecognizers>
                                            </Label>
                                         
                                        </HorizontalStackLayout>
                                    </Border>

                                    <!-- Row 3: Fund My Account (copies the account number for bank transfers) -->
                                    <Border Grid.Row="3" x:Name="FundAccountButton" Margin="0,12,0,0"
                                        HeightRequest="42" VerticalOptions="Center" HorizontalOptions="Fill"
                                        BackgroundColor="White" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 14"
                                        SemanticProperties.Description="Fund my account. Copies your account number for bank transfers.">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_5"/>
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label Text="+" FontSize="18" FontAttributes="Bold" TextColor="#3D2493" VerticalOptions="Center"/>
                                            <Label Text="Fund My Account" FontSize="13" FontAttributes="Bold" TextColor="#3D2493" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </Border>

                                    <!-- Row 4: divider -->
                                    <BoxView Grid.Row="4" HeightRequest="1" Color="#26FFFFFF" Margin="0,18,0,14"
                                             HorizontalOptions="Fill"/>

                                    <!-- Row 5: account name | bank (each centered in its half) -->
                                    <Grid Grid.Row="5" ColumnDefinitions="*,1,*" ColumnSpacing="12">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="ACCOUNT NAME" FontSize="9" FontAttributes="Bold"
                                               CharacterSpacing="1" TextColor="#B9B2E3" HorizontalTextAlignment="Center"/>
                                            <Label x:Name="cardAccountname" FontSize="13" FontAttributes="Bold"
                                               LineBreakMode="TailTruncation" MaxLines="1" TextColor="White"
                                               HorizontalTextAlignment="Center"/>
                                        </VerticalStackLayout>
                                        <BoxView Grid.Column="1" WidthRequest="1" Color="#26FFFFFF" VerticalOptions="Fill"/>
                                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                                            <Label Text="BANK" FontSize="9" FontAttributes="Bold"
                                               CharacterSpacing="1" TextColor="#B9B2E3" HorizontalTextAlignment="Center"/>
                                            <Label x:Name="cardExiprydate" FontSize="13" FontAttributes="Bold"
                                               LineBreakMode="TailTruncation" MaxLines="1" TextColor="White"
                                               HorizontalTextAlignment="Center"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ═════════ Quick actions ═════════ -->
                        <Grid x:Name="TransactionLogStack" Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                            <Frame Grid.Column="0" Style="{StaticResource ActionTileStyle}">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Border StrokeThickness="0" BackgroundColor="#EEE9FF" HeightRequest="{DynamicResource TileBox}" WidthRequest="{DynamicResource TileBox}"
                                        StrokeShape="RoundRectangle 14">
                                        <Image Source="add.png" HeightRequest="{DynamicResource TileImg}" WidthRequest="{DynamicResource TileImg}" Aspect="AspectFit"/>
                                    </Border>
                                    <Label Text="Contract" Style="{StaticResource ActionLabelStyle}"/>
                                </VerticalStackLayout>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnNewContractTapped"/>
                                </Frame.GestureRecognizers>
                            </Frame>

                            <Frame Grid.Column="1" Style="{StaticResource ActionTileStyle}">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Border StrokeThickness="0" BackgroundColor="#E3F6EC" HeightRequest="{DynamicResource TileBox}" WidthRequest="{DynamicResource TileBox}"
                                        StrokeShape="RoundRectangle 14">
                                        <Image Source="bluebag.png" HeightRequest="{DynamicResource TileImg}" WidthRequest="{DynamicResource TileImg}" Aspect="AspectFit"/>
                                    </Border>
                                    <Label Text="Withdraw" Style="{StaticResource ActionLabelStyle}"/>
                                </VerticalStackLayout>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnWithdrawalTapped"/>
                                </Frame.GestureRecognizers>
                            </Frame>

                            <Frame Grid.Column="2" Style="{StaticResource ActionTileStyle}">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Border StrokeThickness="0" BackgroundColor="#FFF0DC" HeightRequest="{DynamicResource TileBox}" WidthRequest="{DynamicResource TileBox}"
                                        StrokeShape="RoundRectangle 14">
                                        <Image Source="image2.png" HeightRequest="{DynamicResource TileImg}" WidthRequest="{DynamicResource TileImg}" Aspect="AspectFit"/>
                                    </Border>
                                    <Label Text="History" Style="{StaticResource ActionLabelStyle}"/>
                                </VerticalStackLayout>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRecentEscrowTapped"/>
                                </Frame.GestureRecognizers>
                            </Frame>

                            <Frame Grid.Column="3" Style="{StaticResource ActionTileStyle}">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Border StrokeThickness="0" BackgroundColor="#FFE4EC" HeightRequest="{DynamicResource TileBox}" WidthRequest="{DynamicResource TileBox}"
                                        StrokeShape="RoundRectangle 14">
                                        <Image Source="image8.png" HeightRequest="{DynamicResource TileImg}" WidthRequest="{DynamicResource TileImg}" Aspect="AspectFit"/>
                                    </Border>
                                    <Label Text="Referral" Style="{StaticResource ActionLabelStyle}"/>
                                </VerticalStackLayout>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                                </Frame.GestureRecognizers>
                            </Frame>
                        </Grid>

                        <!-- ═════════ Activity summary ═════════ -->
                        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Border Grid.Column="0" StrokeThickness="1" Stroke="#ECEEF6" BackgroundColor="White"
                                Padding="14,12" StrokeShape="RoundRectangle 10">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <BoxView WidthRequest="4" HeightRequest="28" CornerRadius="2" Color="#6B4CE6" VerticalOptions="Center"/>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="Contracts" FontSize="10" TextColor="{StaticResource Muted}"/>
                                        <Label x:Name="TransferButton" FontSize="{DynamicResource ValueFont}" FontAttributes="Bold"
                                           LineBreakMode="TailTruncation" MaxLines="1" TextColor="{StaticResource Ink}"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" StrokeThickness="1" Stroke="#ECEEF6" BackgroundColor="White"
                                Padding="14,12" StrokeShape="RoundRectangle 10">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <BoxView WidthRequest="4" HeightRequest="28" CornerRadius="2" Color="#1FA971" VerticalOptions="Center"/>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="Closed" FontSize="10" TextColor="{StaticResource Muted}"/>
                                        <Label x:Name="QuickFundsButton" FontSize="{DynamicResource ValueFont}" FontAttributes="Bold"
                                           LineBreakMode="TailTruncation" MaxLines="1" TextColor="{StaticResource Ink}"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ═════════ Referral banner ═════════ -->
                        <Border x:Name="QuickMenuStack" Grid.Row="3" StrokeThickness="0" Padding="20,18"
                            StrokeShape="RoundRectangle 12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#A25AC4" Offset="0.0"/>
                                    <GradientStop Color="#6B4CE6" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="Invite &amp; earn" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                                    <Label Text="Bring friends onto OPX and unlock referral bonuses."
                                       FontSize="12" TextColor="#E6FFFFFF"/>
                                    <Label Text="View my referral score  →" FontSize="12" FontAttributes="Bold"
                                       TextColor="White" Margin="0,4,0,0"/>
                                </VerticalStackLayout>
                                <Image Grid.Column="1" Source="logo.png" HeightRequest="{DynamicResource BannerImg}" WidthRequest="{DynamicResource BannerImg}"
                                   Aspect="AspectFit" Opacity="0.9" VerticalOptions="Center"/>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_12"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- ═════════ Recent transactions ═════════ -->
                        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="2,2,2,-4">
                            <Label Text="Recent transactions" Style="{StaticResource SectionTitleStyle}"/>
                            <Label Grid.Column="1" Text="See all" FontSize="13" FontAttributes="Bold"
                               TextColor="{StaticResource Brand}" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRecentEscrowTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <VerticalStackLayout x:Name="listView" Grid.Row="5" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border StrokeThickness="1" Stroke="#ECEEF6" BackgroundColor="White"
                                            Padding="14" StrokeShape="RoundRectangle 18">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border Grid.Column="0" StrokeThickness="0" BackgroundColor="#F1EEFF"
                                                    HeightRequest="48" WidthRequest="48" StrokeShape="RoundRectangle 14">
                                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                                    <Label Text="{Binding CreatedAt, StringFormat='{0:dd}'}"
                                                           FontAttributes="Bold" FontSize="17" TextColor="{StaticResource Brand}"
                                                           HorizontalOptions="Center"/>
                                                    <Label Text="{Binding CreatedAt, StringFormat='{0:MMM}'}"
                                                           FontSize="10" TextColor="{StaticResource Muted}"
                                                           HorizontalOptions="Center"/>
                                                </VerticalStackLayout>
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                                <Label Text="{Binding Description}" FontAttributes="Bold" FontSize="14"
                                                       TextColor="{StaticResource Ink}" LineBreakMode="TailTruncation" MaxLines="1"/>
                                                <Label FontSize="11" TextColor="{StaticResource Muted}" LineBreakMode="TailTruncation" MaxLines="1">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding Role}"/>
                                                            <Span Text="  •  "/>
                                                            <Span Text="{Binding CreatedAt, StringFormat='{0:HH:mm}'}"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center"
                                                                 HorizontalOptions="End" Spacing="3">
                                                <Label Text="{Binding Amount, StringFormat='₦{0:N2}'}" FontAttributes="Bold"
                                                       FontSize="15" TextColor="{StaticResource Ink}" HorizontalOptions="End"/>
                                                <Label Text="{Binding Status}" FontSize="11" FontAttributes="Bold"
                                                       TextColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                                       HorizontalOptions="End"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label x:Name="RecentEmptyLabel" Grid.Row="5" IsVisible="False" Text="No recent transactions yet."
                               FontSize="13" TextColor="{StaticResource Muted}" HorizontalOptions="Center" Margin="0,4"/>

                        <!-- Hidden placeholders referenced by existing code-behind -->
                        <Frame x:Name="PlusFrame" IsVisible="False"/>
                        <Frame x:Name="EscrowBorder" IsVisible="False"/>
                        <Grid x:Name="EscrowContent" IsVisible="False"/>
                        <Label x:Name="cardNumberDisplay" IsVisible="False"/>
                        <ScrollView x:Name="TransactionScrollView" IsVisible="False" HeightRequest="1"/>
                    </Grid>
                </Grid>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
