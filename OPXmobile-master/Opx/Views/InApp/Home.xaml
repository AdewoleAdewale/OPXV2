<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Opx.Views.Home"
             xmlns:Renderers="clr-namespace:Opx.Renderers"
             BackgroundColor="#F4F5FB"
             NavigationPage.HasNavigationBar="False"
             Padding="0,-20,0,0">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Renderers:StatusToGradientStartConverter x:Key="StatusToGradientStartConverter"/>
            <Renderers:StatusToColorConverter x:Key="StatusToColorConverter"/>

            <!-- Responsive tokens: defaults here, adjusted for the real screen size in Home.xaml.cs (OnSizeAllocated) -->
            <x:Double x:Key="HeroFont">30</x:Double>
            <x:Double x:Key="AcctFont">22</x:Double>
            <x:Double x:Key="ValueFont">14</x:Double>
            <x:Double x:Key="TileBox">44</x:Double>
            <x:Double x:Key="TileImg">22</x:Double>
            <x:Double x:Key="BlockGap">18</x:Double>
            <x:Double x:Key="CardGap">16</x:Double>
            <x:Double x:Key="BannerImg">64</x:Double>
            <!-- Virtual-card tokens (1:1 at a 360dp / 5.5" phone, scaled down proportionally below that) -->
            <x:Double x:Key="CardBody">13</x:Double>
            <x:Double x:Key="CardSmall">11</x:Double>
            <x:Double x:Key="CardCaption">10</x:Double>
            <x:Double x:Key="CardMicro">9</x:Double>
            <x:Double x:Key="CardIcon">18</x:Double>
            <x:Double x:Key="CardLogo">28</x:Double>
            <x:Double x:Key="CardBtnH">42</x:Double>
            <x:Double x:Key="StatFont">20</x:Double>
            <Thickness x:Key="CardPad">22,20,22,22</Thickness>
            <Thickness x:Key="HeaderPad">20,28,20,26</Thickness>
            <Thickness x:Key="TilePad">0,14</Thickness>

            <Color x:Key="Ink">#161A2E</Color>
            <Color x:Key="Muted">#7A8099</Color>
            <Color x:Key="Brand">#6B4CE6</Color>

            <!-- Kept for other views that may still reference it -->
            <Style x:Key="CardStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="CornerRadius" Value="18"/>
                <Setter Property="HasShadow" Value="False"/>
                <Setter Property="BorderColor" Value="#ECEEF6"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="Label">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource Ink}"/>
            </Style>

            <Style x:Key="ActionTileStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="BorderColor" Value="#ECEEF6"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="HasShadow" Value="False"/>
                <Setter Property="Padding" Value="{DynamicResource TilePad}"/>
                <Setter Property="Margin" Value="0"/>
            </Style>

            <Style x:Key="ActionLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource Ink}"/>
                <Setter Property="HorizontalTextAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="#F4F5FB">
        <RefreshView x:Name="PullRefresh" RefreshColor="#6B4CE6" Refreshing="OnPullRefresh">
            <ScrollView VerticalScrollBarVisibility="Never">
                <Grid x:Name="PageGrid" RowDefinitions="Auto,*" RowSpacing="0" VerticalOptions="Fill">

                    <!-- ═════════ Header: greeting · account strip · balance · three stat chips ═════════ -->
                    <Border x:Name="HeaderGrid" Grid.Row="0" StrokeThickness="0"
                        Padding="{DynamicResource HeaderPad}"
                        StrokeShape="RoundRectangle 0,0,18,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8E44AD" Offset="0.0"/>
                                <GradientStop Color="#8E44AD" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">
                            <!-- Decorative translucent discs (clipped by the header curve) -->
             

                            <!-- Row 0: initials avatar · greeting · refresh · logout -->
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                <Frame Grid.Column="0" CornerRadius="10" HeightRequest="46" WidthRequest="46"
                                   Padding="0" BackgroundColor="#29FFFFFF" BorderColor="#26FFFFFF"
                                   HasShadow="False" x:Name="ProfileFrame">
                                    <Label x:Name="AvatarInitials" Text="U" FontSize="16" FontAttributes="Bold" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Frame>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                    <Label x:Name="GreetingLabel" Text="Welcome back" FontSize="12" TextColor="#D9FFFFFF"/>
                                    <Label x:Name="dashbaordusername" FontSize="18" FontAttributes="Bold"
                                       TextColor="White" LineBreakMode="TailTruncation" MaxLines="1"/>
                                </VerticalStackLayout>

                                <Frame Grid.Column="2" CornerRadius="10" HeightRequest="46" WidthRequest="46"
                                   Padding="0" BackgroundColor="#29FFFFFF" BorderColor="#26FFFFFF"
                                   HasShadow="False" x:Name="RefreshButton"
                                   SemanticProperties.Description="Refresh">
                                    <Label Text="&#x21BB;" FontSize="22" FontAttributes="Bold" TextColor="White"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRefreshTapped"/>
                                    </Frame.GestureRecognizers>
                                </Frame>

                                <Frame Grid.Column="3" CornerRadius="10" HeightRequest="46" WidthRequest="46"
                                   Padding="0" BackgroundColor="#29FFFFFF" BorderColor="#26FFFFFF"
                                   HasShadow="False" x:Name="LogoutButton"
                                   SemanticProperties.Description="Log out">
                                    <!-- Power glyph drawn as a vector so it needs no image asset -->
                                    <Path Data="M12,3 L12,12 M6.86,5.87 A8,8 0 1 0 17.14,5.87"
                                          Stroke="#FFB3C6" StrokeThickness="2.4" StrokeLineCap="Round"
                                          Aspect="Uniform" WidthRequest="18" HeightRequest="19"
                                          HorizontalOptions="Center" VerticalOptions="Center"/>
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnLogoutClicked"/>
                                    </Frame.GestureRecognizers>
                                </Frame>
                            </Grid>

                            <!-- Row 1: virtual account strip (tap to copy the account number) -->
                            <Border Grid.Row="1" StrokeThickness="0" BackgroundColor="#29FFFFFF"
                                Padding="14,12" StrokeShape="RoundRectangle 10"
                                SemanticProperties.Description="Your virtual account. Tap to copy the account number.">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <BoxView WidthRequest="4" HeightRequest="36" CornerRadius="2" Color="#1FA971" VerticalOptions="Center"/>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label x:Name="cardAccountname" FontSize="13" FontAttributes="Bold"
                                           LineBreakMode="TailTruncation" MaxLines="1" TextColor="White"/>
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6">
                                            <Label x:Name="cardaccountNumber" FontSize="12" FontAttributes="Bold"
                                               CharacterSpacing="1" LineBreakMode="NoWrap" MaxLines="1" TextColor="#E6FFFFFF"/>
                                            <Label Grid.Column="1" Text="&#x2022;" FontSize="12" TextColor="#B3FFFFFF"/>
                                            <Label Grid.Column="2" x:Name="cardExiprydate" FontSize="12"
                                               LineBreakMode="TailTruncation" MaxLines="1" TextColor="#D9FFFFFF"/>
                                        </Grid>
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="#33FFFFFF"
                                        Padding="10,5" StrokeShape="RoundRectangle 5" VerticalOptions="Center">
                                        <Label Text="Copy" FontSize="11" FontAttributes="Bold" TextColor="White"/>
                                    </Border>
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_5"/>
                                </Border.GestureRecognizers>
                            </Border>

                            <!-- Row 2: balance -->
                            <VerticalStackLayout x:Name="EscrowCard" Grid.Row="2" Spacing="3" Margin="2,2,0,0">
                                <Label Text="Available balance" FontSize="12" TextColor="#D9FFFFFF"/>
                                <Label x:Name="BalanceLabel" FontSize="{DynamicResource HeroFont}" FontAttributes="Bold"
                                   LineBreakMode="TailTruncation" MaxLines="1" TextColor="White"/>
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="Ledger balance" FontSize="12" TextColor="#D9FFFFFF" VerticalOptions="Center"/>
                                    <Label x:Name="AmountLabel" FontSize="12" FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" MaxLines="1" TextColor="White" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <!-- Row 3: three stat chips -->
                            <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Border Grid.Column="0" StrokeThickness="0" BackgroundColor="#26FFFFFF"
                                    Padding="12,10" StrokeShape="RoundRectangle 10">
                                    <VerticalStackLayout Spacing="1">
                                        <Label x:Name="TransferButton" FontSize="{DynamicResource ValueFont}" FontAttributes="Bold"
                                           LineBreakMode="TailTruncation" MaxLines="1" TextColor="White"/>
                                        <Label Text="Contracts" FontSize="11" TextColor="#D9FFFFFF"/>
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="#26FFFFFF"
                                    Padding="12,10" StrokeShape="RoundRectangle 10">
                                    <VerticalStackLayout Spacing="1">
                                        <Label x:Name="QuickFundsButton" FontSize="{DynamicResource ValueFont}" FontAttributes="Bold"
                                           LineBreakMode="TailTruncation" MaxLines="1" TextColor="White"/>
                                        <Label Text="Completed" FontSize="11" TextColor="#D9FFFFFF"/>
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="#26FFFFFF"
                                    Padding="12,10" StrokeShape="RoundRectangle 10">
                                    <VerticalStackLayout Spacing="1">
                                        <Label x:Name="PendingLabel" Text="0" FontSize="{DynamicResource ValueFont}" FontAttributes="Bold"
                                           LineBreakMode="TailTruncation" MaxLines="1" TextColor="White"/>
                                        <Label Text="Pending" FontSize="11" TextColor="#D9FFFFFF"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid x:Name="MainContent" Grid.Row="1" Padding="16,16,16,28"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="{DynamicResource BlockGap}"
                          HorizontalOptions="Fill" VerticalOptions="Start">

                        <!-- ═════════ Status pills ═════════ -->
                        <HorizontalStackLayout x:Name="QuickMenuStack" Grid.Row="0" Spacing="8" Margin="4,0,0,0">
                            <Border x:Name="AccountPill" StrokeThickness="0" BackgroundColor="#E3F6EC"
                                Padding="12,6" StrokeShape="RoundRectangle 14">
                                <Label x:Name="AccountPillLabel" Text="Account active" FontSize="12" FontAttributes="Bold" TextColor="#1A8F5F"/>
                            </Border>
                            <Border x:Name="NetworkPill" StrokeThickness="0" BackgroundColor="#E3F6EC"
                                Padding="12,6" StrokeShape="RoundRectangle 14">
                                <Label x:Name="NetworkPillLabel" Text="Online" FontSize="12" FontAttributes="Bold" TextColor="#1A8F5F"/>
                            </Border>
                        </HorizontalStackLayout>

                        <Border x:Name="QuickMenuStack2" Grid.Row="1" StrokeThickness="1" Stroke="#E1DAFF"
                            BackgroundColor="#F1EEFF" Padding="10,18" StrokeShape="RoundRectangle 10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                                    <Label Text="Invite and earn" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource Ink}"/>
                                    <Label Text="Bring friends onto OPX and unlock referral bonuses."
                                       FontSize="12" TextColor="{StaticResource Muted}"/>
                                    <Label Text="View my referral score" FontSize="12" FontAttributes="Bold"
                                       TextColor="{StaticResource Brand}" Margin="0,3,0,0"/>
                                </VerticalStackLayout>
                                <Image Grid.Column="1" Source="logo.png" HeightRequest="{DynamicResource BannerImg}" WidthRequest="{DynamicResource BannerImg}"
                                   Aspect="AspectFit" VerticalOptions="Center"/>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_12"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- ═════════ Primary action ═════════ -->
                        <Border x:Name="NewContractCta" Grid.Row="2" StrokeThickness="0" Padding="20,18"
                            StrokeShape="RoundRectangle 10"
                            SemanticProperties.Description="New contract. Hold payment safely until the job is done.">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8E44AD" Offset="0.0"/>
                                    <GradientStop Color="#6B4CE6" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                                    <Label Text="New contract" FontSize="17" FontAttributes="Bold" TextColor="White"/>
                                    <Label Text="Hold payment safely until the job is done"
                                       FontSize="12" TextColor="#E6FFFFFF"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="&#x2192;" FontSize="26" FontAttributes="Bold" TextColor="White"
                                       VerticalOptions="Center"/>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNewContractTapped"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- ═════════ Quick actions (letter badges) ═════════ -->
                        <Grid x:Name="TransactionLogStack" Grid.Row="3" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                            <Frame Grid.Column="0" Style="{StaticResource ActionTileStyle}"
                                   SemanticProperties.Description="Fund account. Copies your account number.">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Border StrokeThickness="0" BackgroundColor="#EEE9FF" HeightRequest="{DynamicResource TileBox}" WidthRequest="{DynamicResource TileBox}"
                                        StrokeShape="RoundRectangle 5">
                                        <Label Text="F" FontSize="18" FontAttributes="Bold" TextColor="#6B4CE6"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Label Text="Fund" Style="{StaticResource ActionLabelStyle}"/>
                                </VerticalStackLayout>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_5"/>
                                </Frame.GestureRecognizers>
                            </Frame>

                            <Frame Grid.Column="1" Style="{StaticResource ActionTileStyle}"
                                   SemanticProperties.Description="Withdraw">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Border StrokeThickness="0" BackgroundColor="#E3F6EC" HeightRequest="{DynamicResource TileBox}" WidthRequest="{DynamicResource TileBox}"
                                        StrokeShape="RoundRectangle 5">
                                        <Label Text="W" FontSize="18" FontAttributes="Bold" TextColor="#1A8F5F"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Label Text="Withdraw" Style="{StaticResource ActionLabelStyle}"/>
                                </VerticalStackLayout>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnWithdrawalTapped"/>
                                </Frame.GestureRecognizers>
                            </Frame>

                            <Frame Grid.Column="2" Style="{StaticResource ActionTileStyle}"
                                   SemanticProperties.Description="History">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Border StrokeThickness="0" BackgroundColor="#FFF0DC" HeightRequest="{DynamicResource TileBox}" WidthRequest="{DynamicResource TileBox}"
                                        StrokeShape="RoundRectangle 5">
                                        <Label Text="H" FontSize="18" FontAttributes="Bold" TextColor="#B26A00"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Label Text="History" Style="{StaticResource ActionLabelStyle}"/>
                                </VerticalStackLayout>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRecentEscrowTapped"/>
                                </Frame.GestureRecognizers>
                            </Frame>

                            <Frame Grid.Column="3" Style="{StaticResource ActionTileStyle}"
                                   SemanticProperties.Description="Referral">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Border StrokeThickness="0" BackgroundColor="#FFE4EC" HeightRequest="{DynamicResource TileBox}" WidthRequest="{DynamicResource TileBox}"
                                        StrokeShape="RoundRectangle 5">
                                        <Label Text="R" FontSize="18" FontAttributes="Bold" TextColor="#D6336C"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Label Text="Referral" Style="{StaticResource ActionLabelStyle}"/>
                                </VerticalStackLayout>
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                                </Frame.GestureRecognizers>
                            </Frame>
                        </Grid>

                        <!-- ═════════ Recent activity ═════════ -->
                        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="2,4,2,-4">
                            <Label Text="Recent activity" Style="{StaticResource SectionTitleStyle}" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="See all" FontSize="13" FontAttributes="Bold"
                               TextColor="{StaticResource Brand}" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRecentEscrowTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <VerticalStackLayout x:Name="listView" Grid.Row="5" Spacing="10" Padding="0,0,0,6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border StrokeThickness="1" Stroke="#ECEEF6" BackgroundColor="White"
                                            Padding="14" StrokeShape="RoundRectangle 10">
                                        <Border.Shadow>
                                            <Shadow Brush="#2B1B7A" Opacity="0.07" Radius="10" Offset="0,3"/>
                                        </Border.Shadow>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border Grid.Column="0" StrokeThickness="0" BackgroundColor="#F1EEFF"
                                                    HeightRequest="48" WidthRequest="48" StrokeShape="RoundRectangle 10">
                                                <Label Text="{Binding Initials}" FontAttributes="Bold" FontSize="15"
                                                       TextColor="{StaticResource Brand}"
                                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                                <Label Text="{Binding Description}" FontAttributes="Bold" FontSize="14"
                                                       TextColor="{StaticResource Ink}" LineBreakMode="TailTruncation" MaxLines="1"/>
                                                <Label FontSize="11" TextColor="{StaticResource Muted}" LineBreakMode="TailTruncation" MaxLines="1">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding Role}"/>
                                                            <Span Text="  •  "/>
                                                            <Span Text="{Binding CreatedAt, StringFormat='{0:MMM d, h:mm tt}'}"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center"
                                                                 HorizontalOptions="End" Spacing="3">
                                                <Label Text="{Binding Amount, StringFormat='₦{0:N2}'}" FontAttributes="Bold"
                                                       FontSize="15" TextColor="{StaticResource Ink}" HorizontalOptions="End"/>
                                                <Label Text="{Binding Status}" FontSize="11" FontAttributes="Bold"
                                                       TextColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                                       HorizontalOptions="End"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label x:Name="RecentEmptyLabel" Grid.Row="6" IsVisible="False"
                               Text="No transactions yet. Your new contracts will show up here."
                               FontSize="13" TextColor="{StaticResource Muted}" HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" Margin="0,4"/>

                        <!-- Hidden placeholders referenced by existing code-behind -->
                        <Frame x:Name="PlusFrame" IsVisible="False"/>
                        <Frame x:Name="EscrowBorder" IsVisible="False"/>
                        <Grid x:Name="EscrowContent" IsVisible="False"/>
                        <Label x:Name="cardNumberDisplay" IsVisible="False"/>
                        <ScrollView x:Name="TransactionScrollView" IsVisible="False" HeightRequest="1"/>
                    </Grid>
                </Grid>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
