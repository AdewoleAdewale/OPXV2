<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:renderers="clr-namespace:Opx.Renderers"
             x:Class="Opx.Views.ContractListDetail"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F4F5FB"
             x:Name="MainPage">

    <ContentPage.Resources>
        <ResourceDictionary>
            <renderers:StatusToColorConverter x:Key="StatusToColorConverter" />

            <!-- Palette (matches Home) -->
            <Color x:Key="PrimaryColor">#6B4CE6</Color>
            <Color x:Key="SecondaryColor">#8E44AD</Color>
            <Color x:Key="AccentColor">#E74C3C</Color>
            <Color x:Key="SuccessColor">#1FA971</Color>
            <Color x:Key="WarningColor">#F39C12</Color>
            <Color x:Key="DangerColor">#E74C3C</Color>
            <Color x:Key="InfoColor">#3498DB</Color>
            <Color x:Key="LightGray">#ECEEF6</Color>
            <Color x:Key="DarkGray">#7A8099</Color>
            <Color x:Key="TextPrimary">#161A2E</Color>
            <Color x:Key="TextSecondary">#7A8099</Color>
            <Color x:Key="CardBackground">#FFFFFF</Color>
            <Color x:Key="ShadowColor">#1A000000</Color>
            <Color x:Key="BrandSoft">#F1EEFF</Color>
            <Color x:Key="Field">#F4F5FB</Color>

            <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#8E44AD" Offset="0.0" />
                <GradientStop Color="#6B4CE6" Offset="1.0" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1FA971" Offset="0.0" />
                <GradientStop Color="#2ECC71" Offset="1.0" />
            </LinearGradientBrush>

            <!-- Styles -->
            <Style x:Key="SectionTitleStyle" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1.5" />
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="Margin" Value="6,22,0,10" />
            </Style>

            <Style x:Key="CaptionStyle" TargetType="Label">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1" />
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
            </Style>

            <Style x:Key="ValueStyle" TargetType="Label">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid>
            <!-- Main Content -->
            <ScrollView x:Name="MainScrollView" VerticalScrollBarVisibility="Never">
                <!-- StackContract is captured for "Share Receipt", so it carries its own background -->
                <StackLayout Spacing="0" x:Name="StackContract" BackgroundColor="#F4F5FB" Padding="16,-32,16,24">

                    <!-- ═════════ Receipt hero ═════════ -->
                    <Border x:Name="Escrowcard" StrokeThickness="0" Padding="0"    HeightRequest="200" WidthRequest="400" VerticalOptions="Start" HorizontalOptions="StartAndExpand"
                            StrokeShape="RoundRectangle 26">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1F1147" Offset="0.0" />
                                <GradientStop Color="#3D2493" Offset="0.6" />
                                <GradientStop Color="#6B4CE6" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="#2B1B7A" Opacity="0.05" Radius="18" Offset="0,8" />
                        </Border.Shadow>

                        <Grid>
                            <!-- Decorative translucent circles -->
                            <Border InputTransparent="True" StrokeThickness="0" BackgroundColor="#14FFFFFF"
                                    WidthRequest="170" HeightRequest="170" StrokeShape="RoundRectangle 85"
                                    HorizontalOptions="End" VerticalOptions="Start" Margin="0,-70,-60,0" />
                            <Border InputTransparent="True" StrokeThickness="0" BackgroundColor="#0DFFFFFF"
                                    WidthRequest="130" HeightRequest="130" StrokeShape="RoundRectangle 65"
                                    HorizontalOptions="Start" VerticalOptions="End" Margin="-50,0,0,-60" />

                            <VerticalStackLayout Padding="22,20,22,22" Spacing="0">

                                <!-- Brand row -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label Text="ESCROW RECEIPT" x:Name="HeaderLabel"
                                               FontSize="14" FontAttributes="Bold" CharacterSpacing="1.5"
                                               TextColor="White" />
                                        <Label Text="{Binding Token, StringFormat='Receipt #{0}'}"
                                               FontSize="11" TextColor="#B9B2E3"
                                               LineBreakMode="MiddleTruncation" MaxLines="1" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" BackgroundColor="#1AFFFFFF" Stroke="#80FFFFFF"
                                            StrokeThickness="1" Padding="10,5" StrokeShape="RoundRectangle 12"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding CreatedAt, StringFormat='{0:dd MMM yyyy}'}"
                                               FontSize="10" FontAttributes="Bold" TextColor="White" />
                                    </Border>
                                </Grid>

                                <!-- Amount -->
                                <VerticalStackLayout x:Name="AmountCard" Spacing="4" Margin="0,24,0,0">
                                    <Label Text="TRANSACTION AMOUNT" FontSize="10" FontAttributes="Bold"
                                           CharacterSpacing="1.5" TextColor="#B9B2E3"
                                           HorizontalOptions="Center" />
                                    <Label x:Name="AmountLabel" FontSize="38" FontAttributes="Bold"
                                           HorizontalOptions="Center" TextColor="White">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="₦" TextColor="#D9D3FF" FontSize="28" />
                                                <Span Text="{Binding Amount, StringFormat='{0:N2}'}" TextColor="White" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Text="Nigerian Naira" FontSize="12" TextColor="#B9B2E3"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>

                                <!-- Status pill -->
                                <Border BackgroundColor="White" StrokeThickness="0" Padding="14,6"
                                        StrokeShape="RoundRectangle 16" HorizontalOptions="Center"
                                        Margin="0,18,0,0">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="●" FontSize="10" VerticalOptions="Center"
                                               TextColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />
                                        <Label Text="{Binding Status}" FontSize="12" FontAttributes="Bold"
                                               VerticalOptions="Center"
                                               TextColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />
                                    </HorizontalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- ═════════ Transaction details ═════════ -->
                    <Label Text="TRANSACTION DETAILS" Style="{StaticResource SectionTitleStyle}" />
                    <Border x:Name="TransactionDetailsCard" Padding="18" StrokeThickness="1"  Margin="-5,-100,0,80"
                            Stroke="{StaticResource LightGray}" BackgroundColor="White"
                            StrokeShape="RoundRectangle 22">
                        <Border.Shadow>
                            <Shadow Brush="#2B1B7A" Opacity="0.06" Radius="12" Offset="0,4" />
                        </Border.Shadow>
                        <StackLayout Spacing="14" BackgroundColor="Transparent">

                            <!-- Description -->
                            <StackLayout x:Name="DescriptionItem" Spacing="4">
                                <Label Text="DESCRIPTION" Style="{StaticResource CaptionStyle}" />
                                <Label Text="{Binding Description}" Style="{StaticResource ValueStyle}" />
                            </StackLayout>

                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource LightGray}" />

                            <!-- Role -->
                            <StackLayout x:Name="RoleItem" Spacing="6">
                                <Label Text="YOUR ROLE" Style="{StaticResource CaptionStyle}" />
                                <Border BackgroundColor="{StaticResource BrandSoft}" StrokeThickness="0"
                                        Padding="12,5" StrokeShape="RoundRectangle 12"
                                        HorizontalOptions="Start">
                                    <Label Text="{Binding Role}" TextColor="#3D2493" FontSize="13"
                                           FontAttributes="Bold" />
                                </Border>
                            </StackLayout>

                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource LightGray}" />

                            <!-- Token -->
                            <StackLayout x:Name="TokenItem" Spacing="6">
                                <Label Text="ESCROW TOKEN" Style="{StaticResource CaptionStyle}" />
                                <Border BackgroundColor="{StaticResource Field}" StrokeThickness="1"
                                        Stroke="{StaticResource LightGray}" Padding="12,10"
                                        StrokeShape="RoundRectangle 12">
                                    <Label Text="{Binding Token}" TextColor="{StaticResource PrimaryColor}"
                                           FontSize="14" FontAttributes="Bold" FontFamily="Courier"
                                           CharacterSpacing="1" />
                                </Border>
                            </StackLayout>

                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource LightGray}" />

                            <!-- Status -->
                            <StackLayout x:Name="StatusItem" Spacing="6">
                                <Label Text="TRANSACTION STATUS" Style="{StaticResource CaptionStyle}" />
                                <Border x:Name="StatusFrame" BackgroundColor="{StaticResource Field}"
                                        StrokeThickness="0" Padding="12,5" StrokeShape="RoundRectangle 12"
                                        HorizontalOptions="Start">
                                    <Label Text="{Binding Status}" x:Name="StatusLabel"
                                           TextColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                           FontSize="13" FontAttributes="Bold" />
                                </Border>
                            </StackLayout>
                        </StackLayout>
                    </Border>

                    <!-- ═════════ Parties ═════════ -->
                    <Label Text="PARTIES INVOLVED" Style="{StaticResource SectionTitleStyle}" />
                    <Border x:Name="PartiesCard" Padding="18" StrokeThickness="1"
                            Stroke="{StaticResource LightGray}" BackgroundColor="White"
                            StrokeShape="RoundRectangle 22">
                        <Border.Shadow>
                            <Shadow Brush="#2B1B7A" Opacity="0.06" Radius="12" Offset="0,4" />
                        </Border.Shadow>
                        <StackLayout Spacing="14" BackgroundColor="Transparent">

                            <StackLayout x:Name="BuyerItem">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <Border BackgroundColor="{StaticResource BrandSoft}" StrokeThickness="0"
                                            WidthRequest="46" HeightRequest="46" StrokeShape="RoundRectangle 16"
                                            VerticalOptions="Center">
                                        <Label Text="🛒" FontSize="20" HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="BUYER" Style="{StaticResource CaptionStyle}" />
                                        <Label Text="{Binding BuyerName}" Style="{StaticResource ValueStyle}"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Grid>
                            </StackLayout>

                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource LightGray}" />

                            <StackLayout x:Name="SellerItem">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <Border BackgroundColor="#E3F6EC" StrokeThickness="0"
                                            WidthRequest="46" HeightRequest="46" StrokeShape="RoundRectangle 16"
                                            VerticalOptions="Center">
                                        <Label Text="🏪" FontSize="20" HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="SELLER" Style="{StaticResource CaptionStyle}" />
                                        <Label Text="{Binding SellerName}" Style="{StaticResource ValueStyle}"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Grid>
                            </StackLayout>
                        </StackLayout>
                    </Border>

                    <!-- ═════════ Timeline ═════════ -->
                    <Label Text="TRANSACTION TIMELINE" Style="{StaticResource SectionTitleStyle}" />
                    <Border x:Name="TimelineCard" Padding="18" StrokeThickness="1"
                            Stroke="{StaticResource LightGray}" BackgroundColor="White"
                            StrokeShape="RoundRectangle 22">
                        <Border.Shadow>
                            <Shadow Brush="#2B1B7A" Opacity="0.06" Radius="12" Offset="0,4" />
                        </Border.Shadow>
                        <StackLayout Spacing="0" x:Name="TimelineStack" BackgroundColor="Transparent">

                            <StackLayout x:Name="CreatedItem">
                                <Grid ColumnDefinitions="28,*" ColumnSpacing="12"
                                      RowDefinitions="Auto,Auto">
                                    <!-- dot + connector -->
                                    <Border Grid.Row="0" Grid.Column="0" BackgroundColor="{StaticResource BrandSoft}"
                                            StrokeThickness="0" WidthRequest="28" HeightRequest="28"
                                            StrokeShape="RoundRectangle 14" VerticalOptions="Start">
                                        <Label Text="📅" FontSize="12" HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                    <BoxView Grid.Row="1" Grid.Column="0" WidthRequest="2" HeightRequest="22"
                                             Color="{StaticResource LightGray}" HorizontalOptions="Center" />

                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2"
                                                         VerticalOptions="Center">
                                        <Label Text="CREATED" Style="{StaticResource CaptionStyle}" />
                                        <Label Text="{Binding CreatedAt, StringFormat='{0:dd MMM yyyy  •  HH:mm}'}"
                                               FontSize="14" FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </StackLayout>

                            <StackLayout>
                                <Grid ColumnDefinitions="28,*" ColumnSpacing="12">
                                    <Border Grid.Column="0" BackgroundColor="{StaticResource Field}"
                                            StrokeThickness="0" WidthRequest="28" HeightRequest="28"
                                            StrokeShape="RoundRectangle 14" VerticalOptions="Start">
                                        <Label Text="●" FontSize="12" HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               TextColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="CURRENT STATUS" Style="{StaticResource CaptionStyle}" />
                                        <Label Text="{Binding Status}" FontSize="14" FontAttributes="Bold"
                                               TextColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </StackLayout>
                        </StackLayout>
                    </Border>

                    <!-- ═════════ Share ═════════ -->
                    <Border x:Name="ShareButton" StrokeThickness="0" HeightRequest="54"
                            Margin="0,24,0,0" HorizontalOptions="Fill"
                            Background="{StaticResource PrimaryGradient}"
                            StrokeShape="RoundRectangle 18">
                        <Border.Shadow>
                            <Shadow Brush="#2B1B7A" Opacity="0.22" Radius="12" Offset="0,6" />
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnShareTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                            <Label Text="↗" FontSize="18" FontAttributes="Bold" TextColor="White"
                                   VerticalOptions="Center" />
                            <Label Text="Share Receipt" FontSize="15" FontAttributes="Bold" TextColor="White"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Footer -->
                    <StackLayout Margin="0,26,0,6" x:Name="FooterStack" Spacing="4">
                        <Label Text="Opx Escrow Platform" FontSize="12" FontAttributes="Bold"
                               TextColor="{StaticResource PrimaryColor}" HorizontalOptions="Center" />
                        <Label Text="Secure • Transparent • Reliable" FontSize="10"
                               TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                    </StackLayout>
                </StackLayout>
            </ScrollView>

            <!-- Loading Overlay -->
            <Grid x:Name="LoadingOverlay" BackgroundColor="#80161A2E" IsVisible="False" InputTransparent="False">
                <Border BackgroundColor="White" StrokeThickness="0" Padding="30"
                        StrokeShape="RoundRectangle 24" HorizontalOptions="Center" VerticalOptions="Center"
                        WidthRequest="200" HeightRequest="130">
                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="14">
                        <ActivityIndicator x:Name="LoadingIndicator" IsVisible="True" IsRunning="True"
                                           Color="{StaticResource PrimaryColor}" HeightRequest="40" WidthRequest="40" />
                        <Label x:Name="LoadingLabel" Text="Loading..." FontSize="15"
                               TextColor="{StaticResource TextPrimary}" FontAttributes="Bold"
                               HorizontalOptions="Center" />
                    </StackLayout>
                </Border>
            </Grid>

            <!-- Error Message -->
            <Border x:Name="ErrorFrame" BackgroundColor="{StaticResource DangerColor}" StrokeThickness="0"
                    StrokeShape="RoundRectangle 16" IsVisible="False" Margin="20"
                    VerticalOptions="End" HorizontalOptions="Fill" />
        </Grid>
    </ContentPage.Content>
</ContentPage>
