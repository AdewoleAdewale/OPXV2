<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Opx.Views.Referral"
             BackgroundColor="#F4F5FB"
             NavigationPage.HasNavigationBar="False"
             Padding="0">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Same palette as Home -->
            <Color x:Key="Ink">#161A2E</Color>
            <Color x:Key="Muted">#7A8099</Color>
            <Color x:Key="Brand">#6B4CE6</Color>
            <Color x:Key="Line">#ECEEF6</Color>

            <Style x:Key="SectionTitleStyle" TargetType="Label">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource Ink}"/>
            </Style>

            <Style x:Key="CaptionStyle" TargetType="Label">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextColor" Value="{StaticResource Muted}"/>
            </Style>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="Stroke" Value="{StaticResource Line}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="StrokeShape" Value="RoundRectangle 18"/>
                <Setter Property="Padding" Value="18"/>
            </Style>

            <Style x:Key="HeaderCircleButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#33FFFFFF"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="CornerRadius" Value="22"/>
                <Setter Property="HeightRequest" Value="44"/>
                <Setter Property="WidthRequest" Value="44"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderWidth" Value="0"/>
            </Style>

            <Style x:Key="ShareTileButton" TargetType="Button">
                <Setter Property="HeightRequest" Value="46"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="BorderWidth" Value="0"/>
                <Setter Property="Padding" Value="8,0"/>
            </Style>

            <Style x:Key="SmallPillButton" TargetType="Button">
                <Setter Property="HeightRequest" Value="40"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="BorderWidth" Value="0"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="MinimumWidthRequest" Value="0"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" BackgroundColor="#F4F5FB">

        <!-- ═════════ Header ═════════ -->
        <Border Grid.Row="0" StrokeThickness="0" BackgroundColor="#8E44AD"
                Padding="20,28,20,22" StrokeShape="RoundRectangle 0,0,22,22">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button Grid.Column="0" x:Name="BackButton" Text="←"
                        Style="{StaticResource HeaderCircleButton}"
                        Clicked="BackButton_Clicked"/>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                    <Label Text="Referral Program" FontSize="18" FontAttributes="Bold"
                           TextColor="White" LineBreakMode="TailTruncation"/>
                    <Label Text="Invite friends, earn rewards" FontSize="12" TextColor="#CCFFFFFF"
                           LineBreakMode="TailTruncation"/>
                </VerticalStackLayout>

                <Button Grid.Column="2" x:Name="RefreshButton" Text="↻"
                        Style="{StaticResource HeaderCircleButton}"
                        Clicked="RefreshButton_Clicked"/>
            </Grid>
        </Border>

        <!-- ═════════ Content ═════════ -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16,16,16,28" Spacing="16">

                <!-- Code + link card -->
                <Border Style="{StaticResource CardStyle}">
                    <Border.Shadow>
                        <Shadow Brush="#2B1B7A" Opacity="0.10" Radius="18" Offset="0,8"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Text="Your referral code" Style="{StaticResource CaptionStyle}"
                                   FontSize="13" VerticalOptions="Center"/>
                            <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="#E4DCFF"
                                    Padding="10,5" StrokeShape="RoundRectangle 12">
                                <HorizontalStackLayout Spacing="4">
                                    <Label x:Name="TotalReferralsLabel" Text="0" FontSize="12"
                                           FontAttributes="Bold" TextColor="{StaticResource Brand}"/>
                                    <Label Text="REFERRALS" FontSize="9" FontAttributes="Bold"
                                           TextColor="{StaticResource Brand}" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <Border BackgroundColor="#F1EEFF" Stroke="#D9CEFF" StrokeThickness="1.5"
                                StrokeDashArray="5,4" Padding="14,14" StrokeShape="RoundRectangle 14">
                            <VerticalStackLayout Spacing="4">
                                <Label x:Name="ReferralCodeLabel" Text="Loading..."
                                       FontSize="24" FontAttributes="Bold" CharacterSpacing="3"
                                       TextColor="{StaticResource Brand}"
                                       HorizontalOptions="Center" HorizontalTextAlignment="Center"
                                       LineBreakMode="MiddleTruncation" MaxLines="1">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnReferralCodeTapped"/>
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Text="Tap the code to copy" FontSize="10" TextColor="#A0A5BA"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <BoxView HeightRequest="1" Color="#E4E6F2"/>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Your referral link" Style="{StaticResource CaptionStyle}"/>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Border Grid.Column="0" BackgroundColor="#F4F5FB" StrokeThickness="0"
                                        Padding="12,0" HeightRequest="40" StrokeShape="RoundRectangle 12">
                                    <Label x:Name="ReferralLinkEntry" Text="Loading..."
                                           FontSize="12" TextColor="{StaticResource Ink}"
                                           VerticalOptions="Center" LineBreakMode="MiddleTruncation" MaxLines="1"/>
                                </Border>
                                <Button Grid.Column="1" x:Name="CopyLinkButton" Text="Copy"
                                        Style="{StaticResource SmallPillButton}"
                                        BackgroundColor="#F1EEFF" TextColor="{StaticResource Brand}"
                                        Clicked="OnCopyLinkClicked"/>
                                <Button Grid.Column="2" x:Name="ShareButton" Text="Share"
                                        Style="{StaticResource SmallPillButton}"
                                        BackgroundColor="#8E44AD" TextColor="White"
                                        Clicked="OnShareButtonClicked"/>
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Share via -->
                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Share via" Style="{StaticResource SectionTitleStyle}" FontSize="15"/>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                            <Button Grid.Row="0" Grid.Column="0" x:Name="ShareWhatsAppButton" Text="WhatsApp"
                                    Style="{StaticResource ShareTileButton}"
                                    BackgroundColor="#E3F6EC" TextColor="#14804F"
                                    Clicked="OnShareWhatsApp"/>
                            <Button Grid.Row="0" Grid.Column="1" x:Name="ShareSMSButton" Text="SMS"
                                    Style="{StaticResource ShareTileButton}"
                                    BackgroundColor="#EEE9FF" TextColor="{StaticResource Brand}"
                                    Clicked="OnShareSMS"/>
                            <Button Grid.Row="1" Grid.Column="0" x:Name="ShareEmailButton" Text="Email"
                                    Style="{StaticResource ShareTileButton}"
                                    BackgroundColor="#FFE4EC" TextColor="#B3345F"
                                    Clicked="OnShareEmail"/>
                            <Button Grid.Row="1" Grid.Column="1" x:Name="ShareMoreButton" Text="More"
                                    Style="{StaticResource ShareTileButton}"
                                    BackgroundColor="#FFF0DC" TextColor="#A85F00"
                                    Clicked="OnShareMore"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Referrals header + search -->
                <Label Text="Your referrals" Style="{StaticResource SectionTitleStyle}" Margin="2,4,2,-6"/>

                <Border BackgroundColor="White" Stroke="{StaticResource Line}" StrokeThickness="1"
                        Padding="0" HeightRequest="48" StrokeShape="RoundRectangle 14">
                    <Grid ColumnDefinitions="44,*,44">
                        <Label Grid.Column="0" Text="🔍" FontSize="16" TextColor="{StaticResource Muted}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" x:Name="SearchEntry"
                               Placeholder="Search by name, email or phone"
                               PlaceholderColor="#A0A5BA" TextColor="{StaticResource Ink}"
                               BackgroundColor="Transparent" FontSize="14"
                               VerticalOptions="Center"
                               TextChanged="SearchEntry_TextChanged"/>
                        <Button Grid.Column="2" x:Name="ClearSearchButton" Text="✕"
                                FontSize="15" TextColor="{StaticResource Muted}"
                                BackgroundColor="Transparent" BorderWidth="0" Padding="0"
                                Clicked="ClearSearchButton_Clicked"/>
                    </Grid>
                </Border>

                <!-- Loading -->
                <VerticalStackLayout x:Name="LoadingSection" IsVisible="False" Padding="20" Spacing="10">
                    <ActivityIndicator x:Name="LoadingIndicator" IsVisible="False" IsRunning="False"
                                       Color="{StaticResource Brand}" HeightRequest="36"/>
                    <Label Text="Loading referrals..." FontSize="13" TextColor="{StaticResource Muted}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Empty -->
                <Border x:Name="EmptyStateContainer" IsVisible="False" Style="{StaticResource CardStyle}" Padding="20,28">
                    <VerticalStackLayout Spacing="6">
                        <Border StrokeThickness="0" BackgroundColor="#F1EEFF" HeightRequest="64" WidthRequest="64"
                                StrokeShape="RoundRectangle 20" HorizontalOptions="Center">
                            <Label Text="👥" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="No referrals yet" FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource Ink}" HorizontalOptions="Center" Margin="0,8,0,0"/>
                        <Label Text="Share your referral link to start earning rewards."
                               FontSize="12" TextColor="{StaticResource Muted}"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Error -->
                <Border x:Name="ErrorStateContainer" IsVisible="False" Style="{StaticResource CardStyle}" Padding="20,28">
                    <VerticalStackLayout Spacing="6">
                        <Border StrokeThickness="0" BackgroundColor="#FFE4EC" HeightRequest="64" WidthRequest="64"
                                StrokeShape="RoundRectangle 20" HorizontalOptions="Center">
                            <Label Text="⚠️" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="Unable to load referrals" FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource Ink}" HorizontalOptions="Center" Margin="0,8,0,0"/>
                        <Label Text="Please check your internet connection and try again."
                               FontSize="12" TextColor="{StaticResource Muted}"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        <Button x:Name="RetryButton" Text="Retry"
                                Style="{StaticResource SmallPillButton}"
                                BackgroundColor="#8E44AD" TextColor="White"
                                HorizontalOptions="Center" Margin="0,10,0,0"
                                Clicked="RetryButton_Clicked"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Referrals list (auto-height: it lives inside the page ScrollView) -->
                <VerticalStackLayout x:Name="ReferralsCollectionView" Spacing="10"
                                     BindableLayout.ItemsSource="{Binding FilteredReferrals}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="White" Stroke="#ECEEF6" StrokeThickness="1"
                                    Padding="14" StrokeShape="RoundRectangle 18">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" StrokeThickness="0" HeightRequest="46" WidthRequest="46"
                                            StrokeShape="RoundRectangle 16" VerticalOptions="Start">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#A25AC4" Offset="0.0"/>
                                                <GradientStop Color="#6B4CE6" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Label Text="{Binding InitialLetter}" FontSize="18" FontAttributes="Bold"
                                               TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding FullName}" FontSize="14" FontAttributes="Bold"
                                               TextColor="#161A2E" LineBreakMode="TailTruncation" MaxLines="1"/>
                                        <Label Text="{Binding Email}" FontSize="11" TextColor="#7A8099"
                                               LineBreakMode="TailTruncation" MaxLines="1"/>
                                        <Label FontSize="11" TextColor="#7A8099"
                                               LineBreakMode="TailTruncation" MaxLines="1">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding PhoneNumber}"/>
                                                    <Span Text="  •  "/>
                                                    <Span Text="{Binding JoinedDate}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>

                                    <Button Grid.Column="2" Text="Copy" FontSize="11" FontAttributes="Bold"
                                            BackgroundColor="#F1EEFF" TextColor="#6B4CE6"
                                            CornerRadius="10" HeightRequest="32" Padding="12,0"
                                            BorderWidth="0" VerticalOptions="Center"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnCopyReferralInfo"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Footer -->
                <Label x:Name="FooterSection" IsVisible="False"
                       Text="Share your referral link with friends to grow your network."
                       FontSize="12" TextColor="{StaticResource Muted}"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,4,0,0"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
