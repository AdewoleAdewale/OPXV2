<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Opx.Views.CreateContract"
             xmlns:renderers="clr-namespace:Opx.Renderers"
             Color="Transparent"
             CanBeDismissedByTappingOutsideOfPopup="True"
             Size="370, 700">

    <!-- Semi-transparent background -->
    <Grid BackgroundColor="#80000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Empty space for tapping to dismiss -->
        <BoxView Grid.Row="0" BackgroundColor="Transparent" />

        <!-- Main sheet content -->
        <Frame x:Name="MainFrame" 
               Grid.Row="1"
               BackgroundColor="White" 
               BorderColor="Transparent"
               CornerRadius="20"
               Padding="0"
               HasShadow="True"
               Margin="0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Drag handle -->
               

                <!-- Content area -->
                <ScrollView Grid.Row="1" 
                          BackgroundColor="White" 
                          Padding="20,0,20,20">
                    <StackLayout Spacing="20">

                        <!-- Logo -->
                        <Image Source="logo.png"
                               HeightRequest="80" 
                               HorizontalOptions="Center"
                               Margin="0,10,0,0" />

                        <!-- Warning message -->
                        <Frame BackgroundColor="#FFF3E0" 
                               BorderColor="#FFB74D" 
                               
                               CornerRadius="10" 
                               Padding="15">
                            <Label Text="⚠️ All contract details must be properly filled before submission" 
                                   TextColor="#F57C00" 
                                   FontSize="12" 
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                        </Frame>

                        <!-- Phone input -->
                        <StackLayout Spacing="5">
                          
                            <Frame x:Name="UserPhoneFrame" 
                                   CornerRadius="10" 
                                   HeightRequest="50"
                                   HasShadow="False" 
                                   BackgroundColor="#F8F9FA" 
                                   BorderColor="#E9ECEF" 
                                   
                                   Padding="15,0">
                                <renderers:BorderlessEntry
                                    x:Name="UserPhone"
                                    FontSize="14"
                                    ClearButtonVisibility="WhileEditing"
                                    Keyboard="Telephone"
                                    HeightRequest="35"
                                    BackgroundColor="Transparent"
                                    Placeholder="Enter phone number"
                                    PlaceholderColor="gray"
                                    TextColor="Black" 
                                    MaxLength="15"
                                    Unfocused="UserPhone_Unfocused"
                                    Focused="OnEntryFocused"
                                    TextChanged="OnEntryTextChanged" />
                            </Frame>
                        </StackLayout>

                       
      

        <!-- Response label -->
        <Label x:Name="ResponseLabel" 
                               FontSize="13" 
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               IsVisible="False" />

        <!-- Description input -->
        <StackLayout Spacing="5">
           
            <Frame x:Name="DescriptionFrame" 
                                   CornerRadius="10" 
                                   HasShadow="False" 
                                   BackgroundColor="#F8F9FA" 
                                   BorderColor="#E9ECEF" 
                                  
                                   Padding="15"
                                   HeightRequest="100">
                <Editor x:Name="Description"
                                        FontSize="14"
                                        MaxLength="200"
                                        BackgroundColor="Transparent"
                                        Placeholder="Describe the contract terms and conditions..."
                                        TextColor="Black"
                                        PlaceholderColor="#6C757D"
                                        AutoSize="TextChanges"
                                        Focused="OnEntryFocused"
                                        TextChanged="OnEntryTextChanged" />
            </Frame>
        </StackLayout>

        <!-- Amount input -->
        <StackLayout Spacing="5">
          
            <Frame x:Name="AmountFrame" 
                                   CornerRadius="10" 
                                   HasShadow="False" 
                                   BackgroundColor="#F8F9FA" 
                                   BorderColor="#E9ECEF" 
                                  HeightRequest="50"
                                   Padding="15,0">
                                <renderers:BorderlessEntry
                                    x:Name="ContractAmount"
                                    FontSize="14"
                                    ClearButtonVisibility="WhileEditing"
                                    Keyboard="Numeric"
                                    HeightRequest="35"
                                    BackgroundColor="Transparent"
                                    Placeholder="Enter amount (₦)"
                                    TextColor="Black"
                                    PlaceholderColor="#6C757D"
                                    Focused="OnEntryFocused">
                                </renderers:BorderlessEntry>
            </Frame>
        </StackLayout>

        <!-- Action buttons -->
                        <StackLayout Spacing="15" Margin="0,20,0,0">
                            <Button x:Name="CREATECONTRACT"
                                    Text="CREATE CONTRACT"
                                    Clicked="CREATECONTRACT_Clicked_1"
                                    BackgroundColor="#6C5CE7"
                                    TextColor="White"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    HeightRequest="50"
                                    IsVisible="False" />

                            <Button Text="Cancel"
                                    Clicked="Button_Clicked"
                                    BackgroundColor="Transparent"
                                    TextColor="#6C5CE7"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    BorderWidth="2"
                                    BorderColor="#6C5CE7"
                                    CornerRadius="12"
                                    HeightRequest="50" />
                        </StackLayout>

                        <!-- Timeout indicator -->
                        <StackLayout Orientation="Horizontal" 
                                   HorizontalOptions="Center" 
                                   Margin="0,20,0,10">
                            <Label Text="⏱️" FontSize="12" />
                            <Label Text="Create Contract Session will timeout after 5 minutes of inactivity" 
                                   FontSize="11" 
                                   TextColor="#6C757D" 
                                   HorizontalOptions="Center" />
                        </StackLayout>

                    </StackLayout>
                </ScrollView>
            </Grid>
        </Frame>
    </Grid>
</toolkit:Popup>