<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Opx.Views.ChangePasswordPage"
             BackgroundColor="#F8F8F8"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="Purple" Padding="16,40,16,16" ColumnDefinitions="Auto,*">
            <Button Grid.Column="0" Text="←" FontSize="22" TextColor="White"
                    BackgroundColor="Transparent" Padding="8,0"
                    Clicked="Back_Clicked"/>
            <Label Grid.Column="1" Text="Change Password" TextColor="White" FontSize="20"
                   FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="18">

                <Label Text="Enter your current password, then choose a new one. Use at least 8 characters with letters and numbers."
                       FontSize="14" TextColor="Gray"/>

                <!-- Current password -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Current Password" FontAttributes="Bold" TextColor="Black"/>
                    <Frame Padding="10,0" HasShadow="True" CornerRadius="10" BackgroundColor="White" BorderColor="#E0E0E0">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry x:Name="CurrentEntry" Placeholder="Current password" IsPassword="True"
                                   FontSize="14" HeightRequest="48" TextChanged="Entry_TextChanged"/>
                            <Button Grid.Column="1" Text="Show" FontSize="12" TextColor="Purple"
                                    BackgroundColor="Transparent" Clicked="ToggleCurrent_Clicked" x:Name="ToggleCurrentBtn"/>
                        </Grid>
                    </Frame>
                </VerticalStackLayout>

                <!-- New password -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="New Password" FontAttributes="Bold" TextColor="Black"/>
                    <Frame Padding="10,0" HasShadow="True" CornerRadius="10" BackgroundColor="White" BorderColor="#E0E0E0">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry x:Name="NewEntry" Placeholder="New password" IsPassword="True"
                                   FontSize="14" HeightRequest="48" TextChanged="Entry_TextChanged"/>
                            <Button Grid.Column="1" Text="Show" FontSize="12" TextColor="Purple"
                                    BackgroundColor="Transparent" Clicked="ToggleNew_Clicked" x:Name="ToggleNewBtn"/>
                        </Grid>
                    </Frame>
                    <Label x:Name="StrengthLabel" FontSize="12" IsVisible="False"/>
                </VerticalStackLayout>

                <!-- Confirm password -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Confirm New Password" FontAttributes="Bold" TextColor="Black"/>
                    <Frame Padding="10,0" HasShadow="True" CornerRadius="10" BackgroundColor="White" BorderColor="#E0E0E0">
                        <Entry x:Name="ConfirmEntry" Placeholder="Confirm new password" IsPassword="True"
                               FontSize="14" HeightRequest="48" TextChanged="Entry_TextChanged"/>
                    </Frame>
                </VerticalStackLayout>

                <Label x:Name="ErrorLabel" TextColor="Red" FontSize="13" IsVisible="False"/>
                <Label x:Name="SuccessLabel" TextColor="ForestGreen" FontSize="13" IsVisible="False"/>

                <Button x:Name="SubmitButton" Text="Update Password"
                        BackgroundColor="Purple" TextColor="White" CornerRadius="8"
                        HeightRequest="50" FontAttributes="Bold" Clicked="Submit_Clicked"/>

                <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False" Color="Purple"/>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
