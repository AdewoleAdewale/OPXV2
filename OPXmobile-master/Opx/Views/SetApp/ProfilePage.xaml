<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Opx.Views.ProfilePage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F4F5FB">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Ink">#161A2E</Color>
            <Color x:Key="Muted">#7A8099</Color>
            <Color x:Key="Brand">#6B4CE6</Color>

            <Style x:Key="RowTitle" TargetType="Label">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource Ink}"/>
            </Style>
            <Style x:Key="RowSubtitle" TargetType="Label">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextColor" Value="{StaticResource Muted}"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- Loading overlay (used by code-behind) -->
        <Frame x:Name="LoadingOverlay" BackgroundColor="#80000000" IsVisible="False" ZIndex="1000"
               CornerRadius="0" HasShadow="False" Padding="0">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
                <ActivityIndicator x:Name="LoadingIndicator" IsVisible="True" IsRunning="True"
                                   Color="#A25AC4" Scale="1.5"/>
                <Label x:Name="LoadingText" Text="Loading..." TextColor="White" FontSize="16"
                       FontAttributes="Bold" HorizontalTextAlignment="Center"/>
            </StackLayout>
        </Frame>

        <RefreshView x:Name="RefreshView" RefreshColor="#6B4CE6"
                     IsRefreshing="{Binding IsRefreshing}"
                     Refreshing="RefreshView_Refreshing">
            <ScrollView x:Name="MainScrollView" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="0">

                    <!-- ═════════ Header with avatar ═════════ -->
                    <Border StrokeThickness="0" Padding="20,26,20,16" StrokeShape="RoundRectangle 0,0,12,12"  BackgroundColor="#8E44AD">
                   
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button x:Name="BackButton" ImageSource="back.png"
                                    BackgroundColor="#33FFFFFF" WidthRequest="44" HeightRequest="44"
                                    CornerRadius="12" Padding="0" Clicked="BackButton_Clicked"/>
                            <Label Grid.Column="1" Text="My profile" FontSize="18" FontAttributes="Bold"
                                   TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <VerticalStackLayout Padding="16,0,16,28" Spacing="16">

                        <!-- ═════════ Identity card (overlaps header) ═════════ -->
                        <Border Margin="0,8,0,0" StrokeThickness="0" BackgroundColor="White"
                                Padding="20,0,20,20" StrokeShape="RoundRectangle 26">
                            <Border.Shadow>
                                <Shadow Brush="#2B1B7A" Opacity="0.14" Radius="20" Offset="0,8"/>
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="14">
                                <Grid HorizontalOptions="Center" Margin="0,8,0,0">
                                    <Frame x:Name="ProfileImageFrame" BackgroundColor="White" BorderColor="White"
                                           CornerRadius="48" HeightRequest="96" WidthRequest="96"
                                           HasShadow="True" Padding="0">
                                        <Image x:Name="ProfileImage" Source="logo.png" Aspect="AspectFill"
                                               HeightRequest="96" WidthRequest="96"/>
                                    </Frame>
                                    <Frame x:Name="UploadButton" BackgroundColor="#6B4CE6" BorderColor="White"
                                           CornerRadius="16" HeightRequest="32" WidthRequest="32" Padding="0"
                                           HasShadow="True" HorizontalOptions="End" VerticalOptions="End"
                                           Margin="0,0,-4,-4">
                                        <Image Source="camera.png" HeightRequest="16" WidthRequest="16"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="UploadProfileImage_Tapped"/>
                                        </Frame.GestureRecognizers>
                                    </Frame>
                                </Grid>

                                <VerticalStackLayout Spacing="4">
                                    <Label x:Name="Fullname" Text="Loading..." FontSize="22" FontAttributes="Bold"
                                           TextColor="{StaticResource Ink}" HorizontalTextAlignment="Center"
                                           LineBreakMode="WordWrap"/>
                                    <Label x:Name="loggedemail" Text="Loading..." FontSize="13"
                                           TextColor="{StaticResource Muted}" HorizontalTextAlignment="Center"
                                           LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>

                                <Border StrokeThickness="0" BackgroundColor="#E3F6EC" Padding="12,6"
                                        HorizontalOptions="Center" StrokeShape="RoundRectangle 14">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="✓" TextColor="#1FA971" FontAttributes="Bold" FontSize="13"/>
                                        <Label Text="Verified account" TextColor="#1FA971" FontAttributes="Bold" FontSize="12"/>
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Profile completion -->
                                <VerticalStackLayout Spacing="6" Margin="0,4,0,0">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Profile completion" FontSize="12" TextColor="{StaticResource Muted}"/>
                                        <Label x:Name="ProgressText" Grid.Column="1" Text="85% Complete"
                                               FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Brand}"/>
                                    </Grid>
                                    <!-- the code sets ProgressBar.WidthRequest as a share of 200 -->
                                    <Border StrokeThickness="0" BackgroundColor="#E9EAF4" HeightRequest="8"
                                            WidthRequest="200" HorizontalOptions="Start" StrokeShape="RoundRectangle 4">
                                        <Border x:Name="ProgressBar" StrokeThickness="0" BackgroundColor="#6B4CE6"
                                                HeightRequest="8" WidthRequest="170" HorizontalOptions="Start"
                                                StrokeShape="RoundRectangle 4"/>
                                    </Border>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- ═════════ Account settings ═════════ -->
                        <Label Text="Account" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Muted}"
                               Margin="6,4,0,-6"/>

                        <Border StrokeThickness="1" Stroke="#ECEEF6" BackgroundColor="White" Padding="0"
                                StrokeShape="RoundRectangle 22">
                            <VerticalStackLayout Spacing="0">

                                <Grid x:Name="UpdatePasswordButton" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="16,14">
                                    <Border StrokeThickness="0" BackgroundColor="#EEE9FF" HeightRequest="42" WidthRequest="42"
                                            StrokeShape="RoundRectangle 14">
                                        <Image Source="icons8eyes.png" HeightRequest="20" WidthRequest="20"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="Update password" Style="{StaticResource RowTitle}"/>
                                        <Label Text="Change your sign-in password" Style="{StaticResource RowSubtitle}"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="›" FontSize="24" TextColor="#B6BACD" VerticalOptions="Center"/>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="UpdatePassword_Tapped"/>
                                    </Grid.GestureRecognizers>
                                </Grid>

                                <BoxView HeightRequest="1" Color="#F0F1F8" Margin="72,0,0,0"/>

                                <Grid x:Name="RecipientButton" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="16,14">
                                    <Border StrokeThickness="0" BackgroundColor="#E3F6EC" HeightRequest="42" WidthRequest="42"
                                            StrokeShape="RoundRectangle 14">
                                        <Image Source="bluebag.png" HeightRequest="20" WidthRequest="20"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="Recipient account" Style="{StaticResource RowTitle}"/>
                                        <Label Text="Where your payouts are sent" Style="{StaticResource RowSubtitle}"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="›" FontSize="24" TextColor="#B6BACD" VerticalOptions="Center"/>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="RecipientAccount_Tapped"/>
                                    </Grid.GestureRecognizers>
                                </Grid>

                                <BoxView HeightRequest="1" Color="#F0F1F8" Margin="72,0,0,0"/>

                                <Grid x:Name="ReferalButton" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="16,14">
                                    <Border StrokeThickness="0" BackgroundColor="#FFE4EC" HeightRequest="42" WidthRequest="42"
                                            StrokeShape="RoundRectangle 14">
                                        <Image Source="upward.png" HeightRequest="20" WidthRequest="20"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="Referrals" Style="{StaticResource RowTitle}"/>
                                        <Label Text="Invite friends and earn bonuses" Style="{StaticResource RowSubtitle}"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="›" FontSize="24" TextColor="#B6BACD" VerticalOptions="Center"/>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="Referral_Tapped"/>
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Not wired to anything in the old page either; kept so the code-behind name still exists -->
                        <Frame x:Name="UpdateProfileButton" IsVisible="False" HeightRequest="1" Padding="0" HasShadow="False"/>

                        <!-- ═════════ Logout ═════════ -->
                        <Border x:Name="LogoutButton" StrokeThickness="1" Stroke="#FFD3DA" BackgroundColor="#FFF3F5"
                                Padding="16,14" StrokeShape="RoundRectangle 12">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                <Image Source="image9.png" HeightRequest="20" WidthRequest="20"/>
                                <Label Text="Log out" FontSize="15" FontAttributes="Bold" TextColor="#D8344F"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Logout_Tapped"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
