<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="WhiteSmoke"
             NavigationPage.HasNavigationBar="False"
             x:Class="Opx.Views.Verification"
             Title="OTP Verification">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Styles -->
            <Style x:Key="OtpEntryStyle" TargetType="Entry">
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="Keyboard" Value="Numeric" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="MaxLength" Value="1" />
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="PlaceholderColor" Value="Gray" />
                <Setter Property="CursorPosition" Value="0" />
                <Setter Property="SelectionLength" Value="0" />
            </Style>

            <Style x:Key="OtpFrameStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="BorderColor" Value="LightGray" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HasShadow" Value="True" />
                <Setter Property="HeightRequest" Value="55" />
                <Setter Property="WidthRequest" Value="55" />
            </Style>

            <Style x:Key="HeaderLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="SubHeaderLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="Gray" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="TimerLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="ResendLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="Purple" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="TextDecorations" Value="Underline" />
                <Setter Property="Padding" Value="10" />
            </Style>

            <Style x:Key="SubmitButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#8E44AD" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HorizontalOptions" Value="Fill" />
                <Setter Property="HeightRequest" Value="55" />
                <Setter Property="Margin" Value="0,10,0,0" />
            </Style>

            <Style x:Key="ErrorLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="#D32F2F" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Padding" Value="10,5" />
            </Style>


        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout Padding="20" VerticalOptions="Fill" Spacing="20">

            <!-- Back Button -->
            <Grid BackgroundColor="Transparent" Padding="10" HeightRequest="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Source="back.png" 
                       HeightRequest="24" 
                       WidthRequest="24" 
                       VerticalOptions="Center"
                       Aspect="AspectFit" />

                <Label Text="BACK" 
                       Grid.Column="1" 
                       VerticalOptions="Center" 
                       HorizontalOptions="Start"
                       FontSize="16" 
                       FontAttributes="Bold" 
                       TextColor="Black" 
                       Margin="10,0,0,0"/>

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                </Grid.GestureRecognizers>
            </Grid>

            <!-- Logo Section -->
            <StackLayout Padding="20,10,20,0" HorizontalOptions="Center">
                <Image Source="logo.png" 
                       HeightRequest="80"
                       WidthRequest="80"
                       Aspect="AspectFit" />
            </StackLayout>

            <!-- Header Section -->
            <StackLayout Spacing="15">
                <Label Text="OTP VERIFICATION"
                       Style="{StaticResource HeaderLabelStyle}"
                       Margin="0,0,0,10"/>

                <Label Text="We sent a 5-digit verification code to your email address. Please enter the code below to verify your account."
                       Style="{StaticResource SubHeaderLabelStyle}"
                       Margin="0,0,0,20"/>
            </StackLayout>

            <!-- OTP Entry Section -->
            <StackLayout Spacing="20">
                <Grid HorizontalOptions="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Label Text="Enter Verification Code"
               FontSize="14"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               TextColor="Gray"
               Grid.Column="0"/>

                    <!-- Paste Button -->
                    <Button Text="PASTE"
                Grid.Column="1"
                BackgroundColor="#8E44AD"
                TextColor="White"
                FontSize="12"
                FontAttributes="Bold"
                CornerRadius="8"
                Padding="15,8"
                Margin="10,0,0,0"
                VerticalOptions="Center"
                Clicked="PasteButton_Clicked"
                AutomationId="PasteButton"
                SemanticProperties.Description="Paste OTP from clipboard"/>
                </Grid>

                <!-- OTP Entry Boxes -->
                <StackLayout Orientation="Horizontal" 
                 HorizontalOptions="Center"
                 Spacing="12">

                    <Frame Style="{StaticResource OtpFrameStyle}">
                        <Entry x:Name="otp1" 
                   Style="{StaticResource OtpEntryStyle}"
                   Placeholder="0"
                   AutomationId="OtpEntry1"
                   SemanticProperties.Description="First digit of OTP"
                   TextChanged="OnOtpTextChanged"/>
                    </Frame>

                    <Frame Style="{StaticResource OtpFrameStyle}">
                        <Entry x:Name="otp2" 
                   Style="{StaticResource OtpEntryStyle}"
                   Placeholder="0"
                   AutomationId="OtpEntry2"
                   SemanticProperties.Description="Second digit of OTP"
                   TextChanged="OnOtpTextChanged"/>
                    </Frame>

                    <Frame Style="{StaticResource OtpFrameStyle}">
                        <Entry x:Name="otp3" 
                   Style="{StaticResource OtpEntryStyle}"
                   Placeholder="0"
                   AutomationId="OtpEntry3"
                   SemanticProperties.Description="Third digit of OTP"
                   TextChanged="OnOtpTextChanged"/>
                    </Frame>

                    <Frame Style="{StaticResource OtpFrameStyle}">
                        <Entry x:Name="otp4" 
                   Style="{StaticResource OtpEntryStyle}"
                   Placeholder="0"
                   AutomationId="OtpEntry4"
                   SemanticProperties.Description="Fourth digit of OTP"
                   TextChanged="OnOtpTextChanged"/>
                    </Frame>

                    <Frame Style="{StaticResource OtpFrameStyle}">
                        <Entry x:Name="otp5" 
                   Style="{StaticResource OtpEntryStyle}"
                   Placeholder="0"
                   AutomationId="OtpEntry5"
                   SemanticProperties.Description="Fifth digit of OTP"
                   TextChanged="OnOtpTextChanged"/>
                    </Frame>
                </StackLayout>

                <!-- Error Message Label (Initially Hidden) -->
                <Frame BackgroundColor="#FFEBEE" 
                       BorderColor="#D32F2F" 
                       CornerRadius="8" 
                       Padding="12,8"
                       HasShadow="False"
                       x:Name="errorFrame"
                       IsVisible="False">
                    <StackLayout Orientation="Horizontal" 
                                 Spacing="8"
                                 HorizontalOptions="Center">
                        <Label Text="⚠" 
                               FontSize="16" 
                               TextColor="#D32F2F"
                               VerticalOptions="Center"/>
                        <Label x:Name="errorLabel"
                               Style="{StaticResource ErrorLabelStyle}"
                               Text="Error message will appear here"
                               VerticalOptions="Center"/>
                    </StackLayout>
                </Frame>
            </StackLayout>

            <!-- Timer Section -->
            <StackLayout Spacing="10">
                <Label Text="Code expires in:"
                       FontSize="12"
                       HorizontalOptions="Center"
                       TextColor="Gray"/>

                <Label x:Name="timerLabel"
                       Text="05:00"
                       Style="{StaticResource TimerLabelStyle}"
                       TextColor="Black"/>
            </StackLayout>

            <!-- Resend Section -->
            <StackLayout Spacing="15">
                <Label Text="Didn't receive the code?"
                       FontSize="12"
                       HorizontalOptions="Center"
                       TextColor="Gray"/>

                <Label Text="Resend Verification Code"
                       Style="{StaticResource ResendLabelStyle}"
                       AutomationId="ResendButton"
                       SemanticProperties.Description="Tap to resend verification code">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_1" />
                    </Label.GestureRecognizers>
                </Label>
            </StackLayout>



            <Button Text="SUBMIT"
                    BackgroundColor="#8E44AD"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HorizontalOptions="Fill"
                    HeightRequest="60"
                    Clicked="SubmitButton_Clicked"/>

        </StackLayout>
    </ScrollView>

</ContentPage>