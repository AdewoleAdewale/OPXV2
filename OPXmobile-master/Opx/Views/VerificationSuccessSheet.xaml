<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Opx.Views.VerificationSuccessSheet"
               Color="Transparent"
               Size="350,450">

    <Frame x:Name="SheetFrame"
           BackgroundColor="White"
           CornerRadius="28"
           HasShadow="True"
           Padding="0"
           TranslationY="400"
           Scale="0.8"
           Opacity="0">

        <Frame.Shadow>
            <Shadow Brush="Black" Opacity="0.25" Offset="0,8" Radius="32" />
        </Frame.Shadow>

        <ScrollView>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Animated Success Header -->
                <Grid Grid.Row="0" 
              Padding="32,40,32,24"
              BackgroundColor="White">

                    <!-- Circular Success Icon with Gradient Background -->
                    <Grid WidthRequest="100" 
                  HeightRequest="100" 
                  HorizontalOptions="Center"
                  VerticalOptions="Center">

                        <!-- Gradient Circle Background -->
                        <Ellipse Fill="#00B894"
                         WidthRequest="100"
                         HeightRequest="100"
                         Opacity="0.12"
                         x:Name="CircleBackground" />

                        <Ellipse Fill="#00B894"
                         WidthRequest="80"
                         HeightRequest="80"
                         Opacity="0.2"
                         x:Name="CircleMiddle" />

                        <Ellipse Fill="#00B894"
                         WidthRequest="64"
                         HeightRequest="64"
                         x:Name="CircleInner" />

                        <!-- Success Checkmark -->
                        <Label x:Name="SuccessIcon"
                       Text="✓" 
                       FontSize="48"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Opacity="0"
                       Scale="0" />
                    </Grid>

                    <!-- Title Section -->
                    <VerticalStackLayout Spacing="8" 
                               Margin="0,120,0,0"
                               HorizontalOptions="Center">
                        <Label Text="Verification Successful!" 
                       FontSize="24" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center"
                       TextColor="#1A1A1A" />

                        <Label x:Name="SubtitleLabel"
                       Text="Your token has been verified"
                       FontSize="15" 
                       HorizontalOptions="Center"
                       TextColor="#6B7280"
                       Opacity="0.85" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Scrollable Content -->
                <ScrollView Grid.Row="1" 
                  Padding="32,12,32,12" 
                  VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="16">


                        <!-- Contract ID Card -->
                        <Frame  HasShadow="True" BorderColor="Transparent" CornerRadius="10" Padding="10" 
                       BackgroundColor="#E8F5E8">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Frame Grid.Column="0" 
                               WidthRequest="48"
                               HeightRequest="48"
                               CornerRadius="12"
                               Padding="0"
                               HasShadow="False"
                               BackgroundColor="#00B894"
                               VerticalOptions="Center">
                                    <Label Text="🔖" 
                                   FontSize="24"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                                </Frame>

                                <VerticalStackLayout Grid.Column="1" 
                                           Spacing="4"
                                           VerticalOptions="Center">
                                    <Label Text="Contract ID" 
                                   FontSize="13" 
                                   TextColor="#6B7280"
                                   FontAttributes="Bold" />
                                    <Label x:Name="ContractIdLabel"
                                   Text="N/A" 
                                   FontSize="19" 
                                   FontAttributes="Bold"
                                   TextColor="#00B894" />
                                </VerticalStackLayout>

                                <!-- Status Badge -->
                                <Frame x:Name="StatusFrame"
                               Grid.Column="2"
                               BackgroundColor="#00B894"
                               Padding="12,6"
                               CornerRadius="20"
                               HasShadow="False"
                               VerticalOptions="Center">
                                    <Label x:Name="StatusLabel"
                                   Text="Confirmed" 
                                   FontSize="12" 
                                   FontAttributes="Bold"
                                   TextColor="White" />
                                </Frame>
                            </Grid>
                        </Frame>

                        <!-- Transaction Details -->
                        <Frame  HasShadow="True" BorderColor="Transparent" CornerRadius="10" Padding="10" BackgroundColor="#F8FAFB">
                            <VerticalStackLayout Spacing="14">
                                <Label Text="Transaction Details" 
                               FontSize="15" 
                               FontAttributes="Bold"
                               TextColor="#1A1A1A" />

                                <!-- Amount -->
                                <Grid x:Name="AmountGrid" 
                              ColumnDefinitions="*,Auto" 
                              IsVisible="False">
                                    <Label Grid.Column="0" 
                                   Text="Amount" 
                                   FontSize="14" 
                                   TextColor="#6B7280"
                                   VerticalOptions="Center" />
                                    <Label x:Name="AmountLabel"
                                   Grid.Column="1" 
                                   Text="₦0.00" 
                                   FontSize="16" 
                                   FontAttributes="Bold"
                                   TextColor="#1A1A1A" />
                                </Grid>

                                <!-- Confirmed At -->
                                <Grid x:Name="ConfirmedAtGrid"
                              ColumnDefinitions="*,Auto"
                              IsVisible="False">
                                    <Label Grid.Column="0" 
                                   Text="Confirmed At" 
                                   FontSize="14" 
                                   TextColor="#6B7280"
                                   VerticalOptions="Center" />
                                    <Label x:Name="ConfirmedAtLabel"
                                   Grid.Column="1" 
                                   Text="N/A" 
                                   FontSize="14" 
                                   TextColor="#1A1A1A" />
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Parties Card -->
                        <Frame  HasShadow="True" BorderColor="Transparent" CornerRadius="10" Padding="10" BackgroundColor="#F8FAFB">
                            <VerticalStackLayout Spacing="14">
                                <Label Text="Parties Involved" 
                               FontSize="15" 
                               FontAttributes="Bold"
                               TextColor="#1A1A1A" />

                                <!-- Seller -->
                                <Grid x:Name="SellerGrid" 
                              ColumnDefinitions="Auto,*" 
                              ColumnSpacing="12"
                              IsVisible="False">
                                    <Frame Grid.Column="0" 
                                   WidthRequest="40"
                                   HeightRequest="40"
                                   CornerRadius="20"
                                   Padding="0"
                                   HasShadow="False"
                                   BackgroundColor="#F3F4F6">
                                        <Label Text="👤" 
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                                    </Frame>
                                    <VerticalStackLayout Grid.Column="1" 
                                               Spacing="2"
                                               VerticalOptions="Center">
                                        <Label Text="Seller" 
                                       FontSize="12" 
                                       TextColor="#6B7280" />
                                        <Label x:Name="SellerNameLabel"
                                       Text="N/A" 
                                       FontSize="15" 
                                       FontAttributes="Bold"
                                       TextColor="#1A1A1A" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Buyer -->
                                <Grid x:Name="BuyerGrid"
                              ColumnDefinitions="Auto,*" 
                              ColumnSpacing="12"
                              IsVisible="False">
                                    <Frame Grid.Column="0" 
                                   WidthRequest="40"
                                   HeightRequest="40"
                                   CornerRadius="20"
                                   Padding="0"
                                   HasShadow="False"
                                   BackgroundColor="#F3F4F6">
                                        <Label Text="👤" 
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                                    </Frame>
                                    <VerticalStackLayout Grid.Column="1" 
                                               Spacing="2"
                                               VerticalOptions="Center">
                                        <Label Text="Buyer" 
                                       FontSize="12" 
                                       TextColor="#6B7280" />
                                        <Label x:Name="BuyerNameLabel"
                                       Text="N/A" 
                                       FontSize="15" 
                                       FontAttributes="Bold"
                                       TextColor="#1A1A1A" />
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Info Message -->
                        <Frame BackgroundColor="#EEF2FF"
                       BorderColor="Transparent"
                       CornerRadius="14"
                       HasShadow="False"
                       Padding="16">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Grid.Column="0"
                               Text="ℹ️" 
                               FontSize="20"
                               VerticalOptions="Start" />
                                <Label Grid.Column="1"
                               x:Name="MessageLabel"
                               Text="The delivery has been confirmed successfully. Both parties have been notified."
                               FontSize="13"
                               TextColor="#4B5563"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center" />
                            </Grid>
                        </Frame>

                    </VerticalStackLayout>
                </ScrollView>

                <!-- Bottom Action Buttons -->
                <Grid Grid.Row="2" 
              Padding="32,16,32,32"
              RowDefinitions="Auto,Auto"
              RowSpacing="12"
              BackgroundColor="White">

                    <Button Grid.Row="0"
                    x:Name="DoneButton"
                    Text="Done"
                    CornerRadius="10"
                    HeightRequest="50"
                    FontSize="16"
                    FontAttributes="Bold"
                    Margin="0"
                    BackgroundColor="#00B894"
                    Clicked="OnDoneClicked"
                    Style="{StaticResource PrimaryButtonStyle}" />


                    <Button Grid.Row="1"
                    x:Name="ViewDetailsButton"
                    Text="View Full Details"
                    Clicked="OnViewDetailsClicked"
                    BackgroundColor="Transparent"
                    TextColor="#00B894"
                    BorderWidth="2"
                    BorderColor="#E5E7EB"
                    CornerRadius="16"
                    HeightRequest="52"
                    FontSize="16"
                    FontAttributes="Bold" />
                </Grid>
            </Grid>
        </ScrollView>
    
    </Frame>
</toolkit:Popup>