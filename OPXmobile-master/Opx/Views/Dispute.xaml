<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Opx.Views.Dispute"
             xmlns:renderers="clr-namespace:Opx.Renderers"
            
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Styles -->
            <Style x:Key="HeaderStyle" TargetType="Label">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="#2C3E50" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,10,0,20" />
            </Style>

            <Style x:Key="SubHeaderStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="#E74C3C" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>

            <Style x:Key="InputFrameStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="BorderColor" Value="#E1E8ED" />
                <Setter Property="HasShadow" Value="True" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="15,10" />
                <Setter Property="Margin" Value="0,5" />
            </Style>

            <Style x:Key="ErrorLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextColor" Value="#E74C3C" />
                <Setter Property="FontAttributes" Value="Italic" />
                <Setter Property="Margin" Value="15,0,0,5" />
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#7B68EE" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HeightRequest" Value="50" />
                <Setter Property="Margin" Value="0,20,0,10" />
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="#7B68EE" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="BorderColor" Value="#7B68EE" />
                <Setter Property="BorderWidth" Value="2" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HeightRequest" Value="50" />
                <Setter Property="Margin" Value="0,5,0,10" />
            </Style>

            <!-- Animations -->
            <Style x:Key="AnimatedFrameStyle" TargetType="Frame" BasedOn="{StaticResource InputFrameStyle}">
                <Setter Property="Scale" Value="1" />
                <Style.Triggers>
                    <Trigger TargetType="Frame" Property="IsFocused" Value="True">
                        <Setter Property="BorderColor" Value="#7B68EE" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Header -->
       

        <!-- Main Content -->
        <ScrollView Grid.Row="1" BackgroundColor="#F8F9FA">
            <StackLayout Padding="20" Spacing="15">

                <!-- Logo -->
                <Frame BackgroundColor="Transparent" CornerRadius="15" Padding="20" HasShadow="True" Margin="0,0,0,10">
                    <Image Source="logo.png"
                           HeightRequest="80" 
                           HorizontalOptions="Center"/>
                </Frame>

                <!-- Alert Message -->
                <Frame BackgroundColor="#FFF3CD" 
                       BorderColor="#FFEAA7" 
                       CornerRadius="12" 
                       Padding="15" 
                       HasShadow="False"
                       Margin="0,0,0,10">
                    <StackLayout Orientation="Horizontal" Spacing="10">
                        <Label Text="⚠️" FontSize="16" VerticalOptions="Start" />
                        <Label Text="Please ensure all contract dispute details are accurately filled in the form below."
                               FontSize="13"
                               TextColor="#8A6D3B"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center"
                               HorizontalOptions="FillAndExpand" />
                    </StackLayout>
                </Frame>

                <!-- Form Container -->
                <Frame BackgroundColor="White" CornerRadius="20" Padding="20" HasShadow="True">
                    <StackLayout Spacing="20">

                        <!-- Token Input -->
                        <StackLayout Spacing="5">
                            <Label Text="Token Number *" 
                                   FontSize="14" 
                                   FontAttributes="Bold"
                                   TextColor="#2C3E50"
                                   Margin="5,0" />

                            <Frame Style="{StaticResource AnimatedFrameStyle}">
                                <renderers:BorderlessEntry
                                    x:Name="InputtToken"
                                    FontSize="16"
                                    ClearButtonVisibility="WhileEditing"
                                    Keyboard="Text"
                                    BackgroundColor="Transparent"
                                    Placeholder="Enter token number"
                                    TextColor="#2C3E50"
                                    PlaceholderColor="#95A5A6"
                                    MaxLength="20"
                                    Text="{Binding TokenText}"
                                    IsEnabled="{Binding IsFormEnabled}" />
                            </Frame>

                            <Label x:Name="TokenErrorLabel" Style="{StaticResource ErrorLabelStyle}" />
                        </StackLayout>

                        <!-- Description Input -->
                        <StackLayout Spacing="5">
                            <StackLayout Orientation="Horizontal" Spacing="5">
                                <Label Text="Contract Description *" 
                                       FontSize="14" 
                                       FontAttributes="Bold"
                                       TextColor="#2C3E50"
                                       HorizontalOptions="StartAndExpand" />

                                <Label Text="{Binding DescriptionText.Length, StringFormat='{0}/500'}"
                                       FontSize="12"
                                       TextColor="#95A5A6"
                                       HorizontalOptions="End" />
                            </StackLayout>

                            <Frame Style="{StaticResource AnimatedFrameStyle}" HeightRequest="120">
                                <Editor x:Name="Description"
                                        FontSize="16"
                                        BackgroundColor="Transparent"
                                        Placeholder="Describe the contract dispute in detail..."
                                        TextColor="#2C3E50"
                                        PlaceholderColor="#95A5A6"
                                        MaxLength="500"
                                        Text="{Binding DescriptionText}"
                                        IsEnabled="{Binding IsFormEnabled}"
                                        AutoSize="TextChanges" />
                            </Frame>

                            <Label x:Name="DescriptionErrorLabel" Style="{StaticResource ErrorLabelStyle}" />
                        </StackLayout>

                        <!-- Progress Indicator -->
                        <StackLayout IsVisible="{Binding IsLoading}" Spacing="10">
                            <ActivityIndicator IsRunning="{Binding IsLoading}"
                                               Color="#7B68EE"
                                               HeightRequest="30" />
                            <Label Text="Processing your dispute request..."
                                   FontSize="14"
                                   TextColor="#7B68EE"
                                   HorizontalTextAlignment="Center" />
                        </StackLayout>

                        <!-- Action Buttons -->
                        <StackLayout Spacing="10" Margin="0,20,0,0">
                            <Button x:Name="CREATECONTRACT"
                                    Text="Initiate Dispute"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Clicked="CREATECONTRACT_Clicked"
                                    IsEnabled="{Binding IsFormValid}" />

                            <Button Text="Cancel"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Clicked="CancelButton_Clicked"
                                    IsEnabled="{Binding IsFormEnabled}" />
                        </StackLayout>

                        <!-- Help Text -->
                        <Frame BackgroundColor="#F8F9FA" 
                               BorderColor="#E1E8ED" 
                               CornerRadius="12" 
                               Padding="10" 
                               HasShadow="False"
                               Margin="0,10,0,0">
                            <StackLayout Orientation="Horizontal" Spacing="10">
                                <Label Text="ℹ️" FontSize="16" VerticalOptions="Start" />
                                <StackLayout HorizontalOptions="FillAndExpand">
                                    <Label Text="Need Help?" 
                                           FontSize="14" 
                                           FontAttributes="Bold"
                                           TextColor="#2C3E50" />
                                    <Label Text="Contact support if you need assistance with your dispute request."
                                           FontSize="12"
                                           TextColor="#7F8C8D"
                                           LineBreakMode="WordWrap" />
                                </StackLayout>
                            </StackLayout>
                        </Frame>

                    </StackLayout>
                </Frame>

                <!-- Footer Space -->
                <BoxView HeightRequest="20" BackgroundColor="Transparent" />

            </StackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <Grid IsVisible="{Binding IsLoading}" 
              BackgroundColor="#80000000" 
              Grid.RowSpan="2">
            <Frame BackgroundColor="White" 
                   CornerRadius="15" 
                   Padding="30"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HasShadow="True">
                <StackLayout Spacing="15">
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       Color="#7B68EE"
                                       HeightRequest="40" />
                    <Label Text="Processing Dispute..."
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#2C3E50"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Please wait while we process your request"
                           FontSize="12"
                           TextColor="#7F8C8D"
                           HorizontalTextAlignment="Center" />
                </StackLayout>
            </Frame>
        </Grid>

    </Grid>
</ContentPage>