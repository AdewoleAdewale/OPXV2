<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F8F9FA"
             xmlns:renderers="clr-namespace:Opx.Renderers"
             x:Class="Opx.Views.Kycform"
             Title="BVN Verification">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Styles -->
            <Style x:Key="HeaderTextStyle" TargetType="Label">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="#1A1A1A" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
            </Style>

            <Style x:Key="SubHeaderTextStyle" TargetType="Label">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor" Value="#6C757D" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="LineHeight" Value="1.4" />
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="#A25AC4" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="HasShadow" Value="True" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HeightRequest" Value="56" />
            </Style>

            <Style x:Key="InputFrameStyle" TargetType="Frame">
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="BorderColor" Value="#E9ECEF" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="HeightRequest" Value="60" />
            </Style>

            <Style x:Key="CardStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="HasShadow" Value="True" />
                <Setter Property="Padding" Value="24" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.Content>
        <ScrollView>
            <Grid RowDefinitions="Auto,*,Auto" Padding="0">

                <!-- Top Section with Gradient Background -->
                <Frame Grid.Row="0" 
                       BackgroundColor="#A25AC4" 
                       CornerRadius="5"
                       HasShadow="True"
                       Padding="20,40,20,30"
                       Margin="0">

                    <StackLayout Spacing="20">
                        <!-- Header with Back Button -->
                        <Grid ColumnDefinitions="40,*,40">
                            <Frame Grid.Column="0" 
                                   BackgroundColor="#9950B8" 
                                   Padding="8" 
                                   HasShadow="False" 
                                   CornerRadius="12"
                                   VerticalOptions="Center">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBackButtonTapped" />
                                </Frame.GestureRecognizers>
                                <Image Source="back.png" 
                                       HeightRequest="24" 
                                       WidthRequest="24"
                                       Aspect="AspectFit" />
                            </Frame>

                            <Label Grid.Column="1"
                                   Text="BVN VERIFICATION" 
                                   VerticalOptions="Center" 
                                   HorizontalOptions="Center"
                                   FontSize="18" 
                                   FontAttributes="Bold" 
                                   TextColor="White" />
                        </Grid>

                        <!-- Logo Section -->
                        <Frame BackgroundColor="White" 
                               HasShadow="True" 
                               Padding="20"
                               CornerRadius="100"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               HeightRequest="120"
                               WidthRequest="120">
                            <Image Source="logo.png" 
                                   Aspect="AspectFit" />
                        </Frame>

                        <!-- Header Text -->
                        <Label Text="Verify Your Identity"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalTextAlignment="Center" />

                        <Label Text="Secure and encrypted verification"
                               FontSize="14"
                               TextColor="#E9D5F0"
                               HorizontalTextAlignment="Center"
                               Margin="0,-10,0,0" />
                    </StackLayout>
                </Frame>

                <!-- Main Content Area -->
                <StackLayout Grid.Row="1" 
                             Spacing="20" 
                             Margin="20"
                             Padding="0,20">

                    <!-- Info Card -->
                    <Frame Style="{StaticResource CardStyle}">
                        <StackLayout Spacing="12">
                            <Label Text="Bank Verification Number"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#1A1A1A" />

                            <Label Text="Enter your 11-digit BVN to complete identity verification. Your data is encrypted and secure."
                                   FontSize="14"
                                   TextColor="#6C757D"
                                   LineHeight="1.3" />
                        </StackLayout>
                    </Frame>

                    <!-- BVN Input Card -->
                    <Frame Style="{StaticResource CardStyle}">
                        <StackLayout Spacing="16">

                            <Label Text="Enter BVN"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#495057" />

                            <!-- BVN Input Field -->
                            <Frame Style="{StaticResource InputFrameStyle}" 
                                   BackgroundColor="#F8F9FA"
                                   BorderColor="#DEE2E6"
                                   Padding="16,0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Image Grid.Column="0"
                                           Source="logo.png" 
                                           HeightRequest="24" 
                                           WidthRequest="24"
                                           VerticalOptions="Center" />

                                    <renderers:BorderlessEntry
                                        Grid.Column="1"
                                        x:Name="BVN"
                                        FontSize="16"
                                        Keyboard="Numeric"
                                        MaxLength="11"
                                        ClearButtonVisibility="WhileEditing"
                                        VerticalTextAlignment="Center"
                                        BackgroundColor="Transparent"
                                        Placeholder="Enter 11-digit BVN"
                                        TextColor="#1A1A1A"
                                        PlaceholderColor="#ADB5BD"
                                        TextChanged="OnBvnTextChanged" />
                                </Grid>
                            </Frame>

                            <!-- Validation Message -->
                            <StackLayout Orientation="Horizontal" 
                                       Spacing="8"
                                       IsVisible="{Binding Source={x:Reference ValidationLabel}, Path=IsVisible}">
                                <BoxView WidthRequest="4"
                                        HeightRequest="20"
                                        CornerRadius="2"
                                        VerticalOptions="Center"
                                        Color="{Binding Source={x:Reference ValidationLabel}, Path=TextColor}" />
                                <Label x:Name="ValidationLabel"
                                       IsVisible="False"
                                       FontSize="13"
                                       TextColor="Red"
                                       VerticalOptions="Center" />
                            </StackLayout>

                            <!-- Security Notice -->
                            <Frame BackgroundColor="#E7F3FF"
                                   BorderColor="#B3D9FF"
                                   CornerRadius="12"
                                   HasShadow="False"
                                   Padding="16">
                                <StackLayout Orientation="Horizontal" Spacing="12">
                                    <Image Source="logo.png" 
                                           HeightRequest="24" 
                                           WidthRequest="24" 
                                           VerticalOptions="Start" />
                                    <Label Text="🔒 Your BVN is encrypted and transmitted securely. We never store your BVN."
                                           FontSize="12"
                                           TextColor="#004085"
                                           LineHeight="1.3"
                                           VerticalOptions="Center"
                                           HorizontalOptions="FillAndExpand" />
                                </StackLayout>
                            </Frame>

                        </StackLayout>
                    </Frame>

                    <!-- Verify Button -->
                    <Frame x:Name="VerifyButton"
                           Style="{StaticResource PrimaryButtonStyle}"
                           Margin="0,10,0,0">
                        <Grid>
                            <!-- Normal State Label -->
                            <Label x:Name="buttonverify"
                                   Text="VERIFY BVN"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   TextColor="White"
                                   FontSize="16"
                                   FontAttributes="Bold" />

                            <!-- Processing State -->
                            <StackLayout x:Name="ProcessingStack"
                                       Orientation="Horizontal" 
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Spacing="12"
                                       IsVisible="False">
                                <ActivityIndicator x:Name="ProcessingIndicator"
                                                 IsRunning="False"
                                                 Color="White" 
                                                 HeightRequest="24" 
                                                 WidthRequest="24" />
                                <Label Text="VERIFYING..." 
                                       TextColor="White" 
                                       FontSize="16" 
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                            </StackLayout>
                        </Grid>

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                        </Frame.GestureRecognizers>
                    </Frame>

                    <!-- Help Section -->
                    <Frame BackgroundColor="#FFF3E0"
                           BorderColor="#FFE0B2"
                           CornerRadius="16"
                           HasShadow="False"
                           Padding="20"
                           Margin="0,10,0,0">
                        <StackLayout Spacing="8">
                            <Label Text="Need Help?" 
                                   FontSize="15" 
                                   FontAttributes="Bold" 
                                   TextColor="#E65100" 
                                   HorizontalTextAlignment="Center" />

                            <Label HorizontalTextAlignment="Center" 
                                   FontSize="13" 
                                   TextColor="#F57C00">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Don't have your BVN? " />
                                        <Span Text="Contact Support" 
                                              TextColor="#A25AC4" 
                                              FontAttributes="Bold"
                                              TextDecorations="Underline">
                                            <Span.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnSupportTapped" />
                                            </Span.GestureRecognizers>
                                        </Span>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </StackLayout>
                    </Frame>

                </StackLayout>

                <!-- Footer Spacing -->
                <BoxView Grid.Row="2" HeightRequest="30" BackgroundColor="Transparent" />

            </Grid>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>